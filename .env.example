# ===================================================================
# MẪU BIẾN MÔI TRƯỜNG CHO DOCKER COMPOSE TRIỂN KHAI HỆ THỐNG GYM MANAGEMENT
# Sao chép file này thành .env trên máy chủ: cp .env.example .env
# ===================================================================

# Mật khẩu quản trị CSDL SQL Server (tối thiểu 8 ký tự gồm chữ hoa, thường, số và ký tự đặc biệt)
MSSQL_SA_PASSWORD=SqlServer@2026
MSSQL_PORT=1433

# Khóa bí mật ký JWT Token cho API (Tối thiểu 32 ký tự bảo mật)
JWT_SIGNING_KEY=GymManagement_Super_Secret_Jwt_Signing_Key_2026_Secure!

# Cấu hình đường dẫn Docker Image trên GitHub Container Registry (GHCR)
API_IMAGE=ghcr.io/kkons2212/gymmanagement-server-api:latest
WEB_IMAGE=ghcr.io/kkons2212/gymmanagement-web:latest

# Cổng truy cập ngoài máy chủ
API_PORT=5000
WEB_PORT=5001
