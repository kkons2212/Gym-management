# ====================================================================
# HỆ THỐNG QUẢN LÝ PHÒNG TẬP THỂ THAO (GYM MANAGEMENT SYSTEM)
# TẬP TIN CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ====================================================================

# 1. CẤU HÌNH KẾT NỐI DOCKER SQL SERVER
# Nếu bạn tự host SQL Server trên Docker, hãy điền thông số tại đây:
DB_HOST=localhost
DB_PORT=1433
DB_NAME=GymManagementDb
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere!

# 2. CHUỖI KẾT NỐI TỔNG HỢP CHO ASP.NET CORE (Nạp tự động vào IConfiguration)
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=GymManagementDb;User Id=sa;Password=YourStrongPasswordHere!;TrustServerCertificate=True;MultipleActiveResultSets=true"

# 3. CẤU HÌNH BẢO MẬT PHIÊN LÀM VIỆC (JWT BEARER)
Jwt__Issuer=GymManagementServer
Jwt__Audience=GymManagementClients
Jwt__SigningKey=GymManagementSystemSecretSigningKey_Minimum32Bytes!

# 4. CẤU HÌNH CỔNG THANH TOÁN VIETQR NAPAS 247
VIETQR_BANK_BIN=970422
VIETQR_BANK_CODE=MB
VIETQR_BANK_NAME="MB Bank (Napas 247)"
VIETQR_ACCOUNT_NO=0901234567
VIETQR_ACCOUNT_NAME="CONG TY TNHH PHONG TAP THE THAO"
