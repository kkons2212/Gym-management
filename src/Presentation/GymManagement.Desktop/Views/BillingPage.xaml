<Page
    x:Class="GymManagement.Desktop.Views.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GymManagement.Desktop.ViewModels"
    xmlns:dto="using:GymManagement.Core.DTOs"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Thu Ngân &amp; Lập Hóa Đơn (Billing &amp; POS)" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Text="Lập phiếu thu, thanh toán qua Tiền mặt / VietQR / Thẻ và quản lý hóa đơn (UC05)" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Main Content 2 Columns -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: POS Form -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="LẬP HÓA ĐƠN MỚI" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Mã hội viên" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.MemberCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Dịch vụ thanh toán" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.SelectedServiceSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Tổng tiền (VNĐ)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox Value="{x:Bind ViewModel.TotalAmount, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Giảm trừ (VNĐ)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox Value="{x:Bind ViewModel.DiscountAmount, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </Grid>

                        <!-- VietQR Placeholder Card -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xED14;" FontSize="36" Foreground="#24B98A" />
                                <TextBlock Text="Quét VietQR động qua app ngân hàng" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Button Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12" Command="{x:Bind ViewModel.CreateInvoiceCommand}">
                            <TextBlock Text="Xác nhận Thanh toán &amp; Xuất Hóa đơn" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Invoices Table -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ListView ItemsSource="{x:Bind ViewModel.InvoicesList, Mode=OneWay}" SelectionMode="Single">
                    <ListView.Header>
                        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MÃ HÓA ĐƠN" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="MÃ HỘI VIÊN" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="DỊCH VỤ" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="THỰC THU" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:InvoiceDto">
                            <Grid Padding="16,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind InvoiceCode}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind MemberCode}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ItemsSummary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind FinalAmount}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#24B98A" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Status}" VerticalAlignment="Center" Foreground="#3B82F6" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
