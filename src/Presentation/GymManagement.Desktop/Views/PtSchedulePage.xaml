<Page
    x:Class="GymManagement.Desktop.Views.PtSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GymManagement.Desktop.ViewModels"
    xmlns:dto="using:GymManagement.Core.DTOs"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="4">
                <TextBlock Text="Điều phối Ca Dạy &amp; Huấn Luyện Viên (PT)" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Xếp lịch ca tập, phân công PT cho học viên và chống xung đột giờ dạy (UC04)" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Phân công PT" Command="{x:Bind ViewModel.OpenAssignDialogCommand}" />
                <Button Content="Xếp ca tập mới" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.OpenBookSessionDialogCommand}" />
            </StackPanel>
        </Grid>

        <!-- Trainer Selection & Date Filter -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="6">
                    <TextBlock Text="CHỌN HUẤN LUYỆN VIÊN (PT)" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.TrainersList, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPt, Mode=TwoWay}" Width="260">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:PtProfileDto">
                                <TextBlock Text="{x:Bind FullName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sessions List -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <ListView ItemsSource="{x:Bind ViewModel.SessionsList, Mode=OneWay}" SelectionMode="Single">
                <ListView.Header>
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MÃ CA" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="THỜI GIAN" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="HỌC VIÊN" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="NỘI DUNG / GHI CHÚ" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PtSessionDto">
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind BookingId}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind StartTime}" VerticalAlignment="Center" Foreground="#3B82F6" />
                            <TextBlock Grid.Column="2" Text="{x:Bind MemberName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Note}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Status}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#24B98A" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Status Message -->
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
