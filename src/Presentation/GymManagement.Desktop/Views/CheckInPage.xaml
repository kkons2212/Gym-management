<Page
    x:Class="GymManagement.Desktop.Views.CheckInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GymManagement.Desktop.ViewModels"
    xmlns:dto="using:GymManagement.Core.DTOs"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Quầy Lễ Tân - Điểm Danh (Check-in)" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Quét mã QR từ điện thoại hội viên hoặc nhập Số điện thoại tra cứu nhanh (UC03)" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Scan Input Box -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" FontSize="18" Padding="12" PlaceholderText="Đặt con trỏ vào đây để quét mã QR hoặc gõ Số điện thoại / Mã hội viên..." Text="{x:Bind ViewModel.InputScanCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Padding="20,12" Command="{x:Bind ViewModel.ProcessCheckInCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D7;" />
                            <TextBlock Text="Xác nhận Check-in" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Alert Bar -->
            <InfoBar IsOpen="{x:Bind ViewModel.ShowAlert, Mode=OneWay}" Severity="Informational" Message="{x:Bind ViewModel.AlertMessage, Mode=OneWay}" IsClosable="True" />

            <!-- Recent Today Logs -->
            <StackPanel Spacing="12">
                <TextBlock Text="Lượt khách vào phòng hôm nay" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <ListView ItemsSource="{x:Bind ViewModel.TodayLogs, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CheckInRecordDto">
                                <Grid ColumnSpacing="16" Padding="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" Foreground="#24B98A" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind MemberName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PackageName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Shift}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind CheckInTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
