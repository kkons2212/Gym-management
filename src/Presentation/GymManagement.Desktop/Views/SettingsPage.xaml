<Page
    x:Class="GymManagement.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GymManagement.Desktop.ViewModels"
    xmlns:dto="using:GymManagement.Core.DTOs"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Cấu Hình Hệ Thống &amp; Danh Mục Gói Tập" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Quản lý các gói tập phòng gym và tham số vận hành chung (UC07)" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Operational Parameters Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="THAM SỐ VẬN HÀNH CHUNG" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Giờ mở cửa" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.OpeningTime, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Giờ đóng cửa" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.ClosingTime, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Hủy lịch PT tối thiểu (giờ)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <NumberBox Value="{x:Bind ViewModel.MinCancellationHours, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Button Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" Command="{x:Bind ViewModel.SaveConfigCommand}">
                        <TextBlock Text="Lưu Tham Số Vận Hành" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Packages Catalog Section -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Danh mục Gói tập Phòng Gym" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Content="Thêm Gói mới" Command="{x:Bind ViewModel.OpenCreatePackageDialogCommand}" />
                </Grid>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <ListView ItemsSource="{x:Bind ViewModel.PackagesList, Mode=OneWay}" SelectionMode="None">
                        <ListView.Header>
                            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TÊN GÓI" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="ĐƠN GIÁ" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="THỜI HẠN" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="SỐ BUỔI PT" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="QUYỀN LỢI" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="TRẠNG THÁI" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dto:PackageDto">
                                <Grid Padding="16,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Price}" Foreground="#24B98A" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind DurationDisplay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SessionCount}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Benefits}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ToggleSwitch Grid.Column="5" IsOn="{x:Bind IsActive}" OnContent="Bật" OffContent="Tắt" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- Status Message -->
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
