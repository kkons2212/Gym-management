<Page
    x:Class="GymManagement.Desktop.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GymManagement.Desktop.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Báo cáo &amp; Thống kê" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Xem báo cáo doanh thu, hội viên và lưu lượng điểm danh theo tiêu chí lọc (UC06)" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Bộ lọc tiêu chí báo cáo -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="TIÊU CHÍ LỌC BÁO CÁO" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Loại báo cáo" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.ReportTypeOptions}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedReportIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="Từ ngày" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <DatePicker Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <TextBlock Text="Đến ngày" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <DatePicker Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" />
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="3"
                                VerticalAlignment="Bottom"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.LoadReportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock Text="Xem báo cáo" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Thanh thông báo kết quả -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Informational"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <!-- Kết quả báo cáo -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ReportTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.ReportSubtitle, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Biểu đồ cột (UC06 – bước 6) -->
                    <Border Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8" Padding="16" MinHeight="260">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReportRow">
                                    <!-- Canh đáy để nhãn trục hoành của mọi cột luôn thẳng hàng -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="6">
                                        <TextBlock Text="{x:Bind DisplayValue}" HorizontalAlignment="Center"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                        <Rectangle Width="48" Height="{x:Bind BarHeight}" Fill="#24B98A" RadiusX="4" RadiusY="4" />
                                        <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Bảng số liệu (UC06 – bước 6) -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                        <TextBlock Text="BẢNG SỐ LIỆU" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,4" />

                        <Grid ColumnSpacing="16" Padding="12,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Chỉ tiêu" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Giá trị" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Tỷ trọng" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReportRow">
                                    <Grid ColumnSpacing="16" Padding="12,10"
                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                          BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ShareText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Trạng thái không có dữ liệu (UC06 – 5.1.2) -->
                    <Border Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8" Padding="32" MinHeight="200">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <SymbolIcon Symbol="Important" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Không có dữ liệu phù hợp." HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="Vui lòng thay đổi tiêu chí tra cứu rồi xem lại báo cáo."
                                       HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
