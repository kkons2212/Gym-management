@page "/pt/profile"
@rendermode InteractiveServer

<PageTitle>GYM HOUSE – Thông tin Huấn luyện viên</PageTitle>

<div class="section animate-down">
    <!-- PT Header Banner -->
    <div class="card mb-md"
         style="background:linear-gradient(145deg,#1a3a4d,#0f2438); border-color:rgba(59,130,246,0.3); text-align:center; padding:28px 20px;">
        <div class="avatar avatar-lg"
             style="margin:0 auto 12px; font-size:1.8rem; background:linear-gradient(135deg,#3B82F6,#8B5CF6);">QB</div>
        <h1 style="font-size:1.2rem; color:#fff; margin-bottom:4px;">Nguyễn Quốc Bảo</h1>
        <div style="font-size:0.8rem; color:rgba(255,255,255,0.6);">Mã số: PT-01</div>
        <div class="d-flex gap-sm justify-center mt-sm">
            <span class="badge badge-info">Gym &amp; Cơ bắp</span>
            <span class="badge badge-success">Đang hoạt động ✓</span>
        </div>
    </div>

    <!-- Thông tin Chuyên môn & Hợp đồng (Chỉ Admin sửa) -->
    <div class="d-flex justify-between items-center mb-sm">
        <div class="section-title">Hồ sơ chuyên môn &amp; Hợp đồng</div>
        
    </div>

    <div class="card mb-md" style="padding:0;">
        <div class="list-item">
            <span style="font-size:1rem; width:24px; text-align:center;">🏋️</span>
            <div style="flex:1;">
                <div class="text-caption">Chuyên môn chính</div>
                <div class="fw-semibold">Gym, Thể hình &amp; Tăng cơ chuyên sâu</div>
            </div>
           
        </div>
        <div class="list-item">
            <span style="font-size:1rem; width:24px; text-align:center;">🎖️</span>
            <div style="flex:1;">
                <div class="text-caption">Kinh nghiệm huấn luyện</div>
                <div class="fw-semibold">5 năm kinh nghiệm</div>
            </div>
        </div>
        <div class="list-item">
            <span style="font-size:1rem; width:24px; text-align:center;">💵</span>
            <div style="flex:1;">
                <div class="text-caption">Mức lương cơ bản (Hợp đồng)</div>
                <div class="fw-semibold" style="color:#F59E0B;">18.500.000 VNĐ / tháng</div>
            </div>
           
        </div>
        <div class="list-item" style="border-bottom:none;">
            <span style="font-size:1rem; width:24px; text-align:center;">⭐</span>
            <div style="flex:1;">
                <div class="text-caption">Đánh giá học viên</div>
                <div class="fw-semibold" style="color:#F59E0B;">4.9 / 5.0 (48 lượt đánh giá)</div>
            </div>
        </div>
    </div>

    <!-- Thông tin liên hệ cá nhân (PT được phép chỉnh sửa) -->
    <div class="d-flex justify-between items-center mb-sm">
        <div class="section-title">Thông tin liên hệ cá nhân</div>
        
    </div>

    <div class="card mb-md" style="padding:0;">
        <div class="list-item">
            <span style="font-size:1rem; width:24px; text-align:center;">📱</span>
            <div style="flex:1;">
                <div class="text-caption">Số điện thoại liên hệ</div>
                <div class="fw-semibold">0903 456 789</div>
            </div>
        </div>
        <div class="list-item">
            <span style="font-size:1rem; width:24px; text-align:center;">📧</span>
            <div style="flex:1;">
                <div class="text-caption">Địa chỉ Email</div>
                <div class="fw-semibold">bao.nguyen@gymhouse.vn</div>
            </div>
        </div>
        <div class="list-item">
            <span style="font-size:1rem; width:24px; text-align:center;">🎂</span>
            <div style="flex:1;">
                <div class="text-caption">Ngày sinh</div>
                <div class="fw-semibold">15/04/1993</div>
            </div>
        </div>
        <div class="list-item" style="border-bottom:none;">
            <span style="font-size:1rem; width:24px; text-align:center;">⚧️</span>
            <div style="flex:1;">
                <div class="text-caption">Giới tính</div>
                <div class="fw-semibold">Nam</div>
            </div>
        </div>
    </div>

    <!-- Nút thao tác điều hướng -->
    <div class="d-flex gap-sm mb-md">
        <a href="/pt" class="btn btn-secondary w-full" style="text-align:center;">🏠 Về Trang chủ PT</a>
        <a href="/" class="btn btn-ghost w-full" style="text-align:center; color:var(--clr-text-secondary);">🚪 Về Cổng
            Hội viên</a>
        </div>
    </div>
