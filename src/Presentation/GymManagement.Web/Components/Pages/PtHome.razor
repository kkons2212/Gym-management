@page "/pt"
@rendermode InteractiveServer

<PageTitle>GYM HOUSE – Cổng Huấn Luyện Viên</PageTitle>

<div class="section animate-down">
    <!-- PT Greeting Banner -->
    <div class="card card-primary mb-md" style="background: linear-gradient(135deg, #1e3a5f 0%, #0f2b48 100%); border-color: rgba(59,130,246,0.4);">
        <div class="d-flex items-center justify-between">
            <div>
                <div class="text-caption mb-sm" style="color:rgba(255,255,255,0.7);">Cổng Tác Nghiệp HLV 👋</div>
                <h1 style="font-size:1.3rem; color:#fff; margin-bottom:4px;">Nguyễn Quốc Bảo</h1>
                <div class="d-flex gap-sm">
                    <span class="badge badge-info">PT-01</span>
                    <span class="badge badge-success">Đang hoạt động ✓</span>
                </div>
            </div>
            <div class="avatar avatar-lg animate-glow" style="font-size:1.5rem; background: linear-gradient(135deg,#3B82F6,#8B5CF6);">QB</div>
        </div>
    </div>

    <!-- KPI Stats Row for PT -->
    <div class="grid-2 mb-md" style="gap:12px;">
        <div class="stat-card animate-fade">
            <div class="stat-label">Ca dạy hôm nay</div>
            <div class="stat-value" style="color:#3B82F6;">2 ca</div>
            <div class="text-caption">14:00 và 16:00 chiều</div>
        </div>
        <div class="stat-card animate-fade">
            <div class="stat-label">Học viên phụ trách</div>
            <div class="stat-value" style="color:#24B98A;">2 bạn</div>
            <div class="text-caption">Nguyễn Minh Anh, Trần Quốc Bảo</div>
        </div>
    </div>

    <div class="grid-2 mb-md" style="gap:12px;">
        <div class="stat-card animate-fade">
            <div class="stat-label">Đánh giá trung bình</div>
            <div class="stat-value" style="color:#F59E0B;">⭐ 4.9</div>
            <div class="text-caption">Dựa trên 48 lượt phản hồi</div>
        </div>
        <div class="stat-card animate-fade">
            <div class="stat-label">Chuyên môn chính</div>
            <div class="stat-value" style="font-size:1.1rem; color:#EC4899; padding-top:4px;">Gym &amp; Cơ bắp</div>
            <div class="text-caption">5 năm kinh nghiệm</div>
        </div>
    </div>
</div>

<!-- Quick Navigation to PT Sections -->
<div class="section" style="padding-top:0;">
    <div class="section-header">
        <div class="section-title">Chức năng Huấn luyện viên</div>
    </div>
    <div class="grid-3 mb-md" style="gap:10px;">
        <a href="/pt/schedule" class="card" style="text-align:center; padding:16px 8px; text-decoration:none; color:inherit;">
            <div style="font-size:1.8rem; margin-bottom:6px;">📅</div>
            <div style="font-size:0.8rem; font-weight:600;">Lịch dạy</div>
            <div class="text-caption" style="font-size:0.7rem;">&amp; Lịch rảnh</div>
        </a>
        <a href="/pt/students" class="card" style="text-align:center; padding:16px 8px; text-decoration:none; color:inherit;">
            <div style="font-size:1.8rem; margin-bottom:6px;">👥</div>
            <div style="font-size:0.8rem; font-weight:600;">Học viên</div>
            <div class="text-caption" style="font-size:0.7rem;">Đo InBody</div>
        </a>
        <a href="/pt/profile" class="card" style="text-align:center; padding:16px 8px; text-decoration:none; color:inherit;">
            <div style="font-size:1.8rem; margin-bottom:6px;">👤</div>
            <div style="font-size:0.8rem; font-weight:600;">Hồ sơ PT</div>
            <div class="text-caption" style="font-size:0.7rem;">Chuyên môn</div>
        </a>
    </div>

    <!-- Ca dạy hôm nay -->
    <div class="section-header">
        <div class="section-title">Lịch dạy hôm nay</div>
        <a href="/pt/schedule" class="text-caption" style="color:var(--clr-primary); text-decoration:none;">Xem tất cả ›</a>
    </div>

    <div class="card mb-md" style="padding:0;">
        <div class="list-item">
            <div style="min-width:55px; text-align:center;">
                <div class="fw-bold" style="font-size:0.95rem; color:#3B82F6;">14:00</div>
                <div class="text-caption">60 phút</div>
            </div>
            <div style="flex:1; padding-left:10px;">
                <div class="fw-semibold" style="font-size:0.9rem;">Nguyễn Minh Anh (MB-0248)</div>
                <div class="text-caption">Buổi 5/12 · Tập cơ lưng và vai</div>
            </div>
            <span class="badge badge-success">Đã xác nhận</span>
        </div>
        <div class="list-item" style="border-bottom:none;">
            <div style="min-width:55px; text-align:center;">
                <div class="fw-bold" style="font-size:0.95rem; color:#3B82F6;">16:00</div>
                <div class="text-caption">60 phút</div>
            </div>
            <div style="flex:1; padding-left:10px;">
                <div class="fw-semibold" style="font-size:0.9rem;">Trần Quốc Bảo (MB-0247)</div>
                <div class="text-caption">Buổi 7/12 · Cardio và chân</div>
            </div>
            <span class="badge badge-info">Sắp diễn ra</span>
        </div>
    </div>

    <!-- Thông báo / Nhắc nhở từ Admin -->
    <div class="alert alert-info mb-md">
        📢 <strong>Nhắc nhở từ Ban Quản Trị:</strong> Huấn luyện viên vui lòng cập nhật lịch rảnh cho tuần kế tiếp trước 20:00 Chủ Nhật hàng tuần.
    </div>
</div>
