@page "/inbody"
@rendermode InteractiveServer
@inject IPtService PtService

<PageTitle>GYM HOUSE – Chỉ số InBody</PageTitle>

<div class="section animate-down">
    <div class="section-header mb-md">
        <h1 class="section-title" style="font-size:1.1rem;">📊 Chỉ số cơ thể (InBody)</h1>
    </div>

    <!-- Latest measurement highlight -->
    @if (Records.Count > 0)
    {
        var latest = Records[0];
        var prev   = Records.Count > 1 ? Records[1] : null;

        <div class="card" style="background:linear-gradient(145deg, #1a2f3a, #1a2245); border-color:rgba(59,130,246,0.4); margin-bottom:16px;">
            <div class="text-caption mb-sm" style="color:rgba(255,255,255,0.6);">Lần đo gần nhất · @latest.MeasuredDate.ToString("dd/MM/yyyy")</div>
            <div class="grid-3" style="gap:16px; margin-bottom:16px;">
                <div class="text-center">
                    <div style="font-size:1.8rem; font-weight:800; color:#fff;">@latest.WeightKg<span style="font-size:0.8rem; font-weight:400; opacity:0.6;">kg</span></div>
                    <div class="text-caption" style="color:rgba(255,255,255,0.5);">Cân nặng</div>
                    @if (prev != null)
                    {
                        var diff = latest.WeightKg - prev.WeightKg;
                        <div style="font-size:0.72rem; color:@(diff < 0 ? "var(--clr-primary)" : "var(--clr-danger)");">
                            @(diff > 0 ? "+" : "")@diff.ToString("0.0")kg
                        </div>
                    }
                </div>
                <div class="text-center">
                    <div style="font-size:1.8rem; font-weight:800; color:var(--clr-warning);">@latest.BodyFatPercent<span style="font-size:0.8rem; font-weight:400; opacity:0.8;">%</span></div>
                    <div class="text-caption" style="color:rgba(255,255,255,0.5);">Mỡ cơ thể</div>
                    @if (prev != null)
                    {
                        var diff = latest.BodyFatPercent - prev.BodyFatPercent;
                        <div style="font-size:0.72rem; color:@(diff < 0 ? "var(--clr-primary)" : "var(--clr-danger)");">
                            @(diff > 0 ? "+" : "")@diff.ToString("0.0")%
                        </div>
                    }
                </div>
                <div class="text-center">
                    <div style="font-size:1.8rem; font-weight:800; color:var(--clr-primary);">@latest.MuscleMassKg<span style="font-size:0.8rem; font-weight:400; opacity:0.8;">kg</span></div>
                    <div class="text-caption" style="color:rgba(255,255,255,0.5);">Cơ bắp</div>
                    @if (prev != null)
                    {
                        var diff = latest.MuscleMassKg - prev.MuscleMassKg;
                        <div style="font-size:0.72rem; color:@(diff > 0 ? "var(--clr-primary)" : "var(--clr-danger)");">
                            @(diff > 0 ? "+" : "")@diff.ToString("0.0")kg
                        </div>
                    }
                </div>
            </div>

            <!-- Progress bars -->
            <div style="display:flex; flex-direction:column; gap:10px;">
                <div>
                    <div class="d-flex justify-between mb-sm" style="font-size:0.75rem;">
                        <span style="color:rgba(255,255,255,0.7);">Chỉ số mỡ</span>
                        <span style="color:var(--clr-warning); font-weight:700;">@latest.BodyFatPercent%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill warning" style="width:@Math.Min(100,(double)latest.BodyFatPercent*3)%;"></div>
                    </div>
                    <div class="d-flex justify-between" style="font-size:0.65rem; color:rgba(255,255,255,0.4); margin-top:3px;">
                        <span>0%</span><span style="color:var(--clr-primary);">Mức lý tưởng: 10–20%</span><span>35%+</span>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-between mb-sm" style="font-size:0.75rem;">
                        <span style="color:rgba(255,255,255,0.7);">Khối cơ bắp</span>
                        <span style="color:var(--clr-primary); font-weight:700;">@latest.MuscleMassKg kg</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width:@Math.Min(100,(double)latest.MuscleMassKg/80*100)%;"></div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(latest.Note))
            {
                <div class="alert alert-info mt-md" style="background:rgba(59,130,246,0.1); border-color:rgba(59,130,246,0.3); color:#93C5FD;">
                    💬 @latest.Note · <span style="opacity:0.7;">bởi @latest.MeasuredByPtName</span>
                </div>
            }
        </div>
    }

    <!-- Chart placeholder -->
    <div class="section-header">
        <div class="section-title">Lịch sử tiến trình</div>
        <div class="d-flex gap-xs">
            @foreach (var metric in new[] { "Cân nặng", "Mỡ%", "Cơ bắp" })
            {
                <button class="btn btn-sm @(ActiveMetric == metric ? "btn-primary" : "btn-secondary")"
                        @onclick="() => ActiveMetric = metric">@metric</button>
            }
        </div>
    </div>

    <!-- Simulated sparkline chart -->
    <div class="card mb-md" style="padding:20px;">
        <div class="d-flex items-center justify-between mb-md">
            <div class="fw-semibold">@ActiveMetric</div>
            <span class="badge badge-success">Cải thiện 📈</span>
        </div>
        <svg viewBox="0 0 300 80" style="width:100%; height:80px;" preserveAspectRatio="none">
            <defs>
                <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#24B98A" stop-opacity="0.4"/>
                    <stop offset="100%" stop-color="#24B98A" stop-opacity="0"/>
                </linearGradient>
            </defs>
            <!-- Grid lines -->
            <line x1="0" y1="20" x2="300" y2="20" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
            <line x1="0" y1="40" x2="300" y2="40" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
            <line x1="0" y1="60" x2="300" y2="60" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
            <!-- Chart area fill -->
            <path d="@GetChartPath(true)" fill="url(#chartGrad)" opacity="0.7"/>
            <!-- Chart line -->
            <path d="@GetChartPath(false)" fill="none" stroke="#24B98A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- Data points -->
            @foreach (var pt in GetChartPoints())
            {
                <circle cx="@pt.x" cy="@pt.y" r="4" fill="#24B98A" stroke="#0D1117" stroke-width="2"/>
            }
        </svg>
        <!-- X axis labels -->
        <div class="d-flex justify-between mt-sm">
            @foreach (var r in Records.TakeLast(6))
            {
                <span class="text-caption">@r.MeasuredDate.ToString("MM/yy")</span>
            }
        </div>
    </div>

    <!-- History table -->
    <div class="section-title mb-md">Chi tiết từng lần đo</div>
    <div class="card" style="padding:0; overflow-x:auto;">
        <table class="gym-table">
            <thead>
                <tr>
                    <th>Ngày</th>
                    <th style="text-align:right;">Cân(kg)</th>
                    <th style="text-align:right;">Mỡ(%)</th>
                    <th style="text-align:right;">Cơ(kg)</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Records)
                {
                    <tr>
                        <td><span class="fw-semibold">@r.MeasuredDate.ToString("dd/MM/yy")</span></td>
                        <td style="text-align:right;">@r.WeightKg</td>
                        <td style="text-align:right; color:var(--clr-warning);">@r.BodyFatPercent%</td>
                        <td style="text-align:right; color:var(--clr-primary);">@r.MuscleMassKg</td>
                        <td style="font-size:0.8rem; color:var(--clr-text-secondary);">@(r.Note ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<InBodyRecordDto> Records = [];
    private string ActiveMetric = "Cân nặng";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Records = (await PtService.GetInBodyHistoryAsync("MB-0248")).OrderByDescending(r => r.MeasuredDate).ToList();
        }
        catch
        {
            var now = DateTime.Now;
            Records =
            [
                new InBodyRecordDto("IB-06","MB-0248",now.AddDays(-5),72.3m,18.2m,58.1m,"Tiến bộ tốt!","Nguyễn Văn An"),
                new InBodyRecordDto("IB-05","MB-0248",now.AddDays(-35),73.8m,19.5m,57.4m,null,"Nguyễn Văn An"),
                new InBodyRecordDto("IB-04","MB-0248",now.AddDays(-65),75.1m,21.0m,56.8m,"Cần tăng cường tập","Nguyễn Văn An"),
                new InBodyRecordDto("IB-03","MB-0248",now.AddDays(-95),76.5m,22.3m,56.1m,null,"Nguyễn Văn An"),
                new InBodyRecordDto("IB-02","MB-0248",now.AddDays(-125),77.2m,23.1m,55.5m,"Bắt đầu tập","Nguyễn Văn An"),
                new InBodyRecordDto("IB-01","MB-0248",now.AddDays(-155),78.0m,24.0m,54.9m,null,"Nguyễn Văn An"),
            ];
        }
    }

    private List<decimal> GetMetricValues() => ActiveMetric switch
    {
        "Mỡ%"    => Records.TakeLast(6).Select(r => r.BodyFatPercent).ToList(),
        "Cơ bắp" => Records.TakeLast(6).Select(r => r.MuscleMassKg).ToList(),
        _         => Records.TakeLast(6).Select(r => r.WeightKg).ToList(),
    };

    private List<(double x, double y)> GetChartPoints()
    {
        var vals = GetMetricValues();
        if (!vals.Any()) return [];
        var min = (double)vals.Min(); var max = (double)vals.Max();
        var range = max - min < 0.01 ? 1 : max - min;
        var pts = new List<(double, double)>();
        for (int i = 0; i < vals.Count; i++)
        {
            var x = vals.Count == 1 ? 150 : i * (300.0 / (vals.Count - 1));
            var y = 70 - ((double)vals[i] - min) / range * 60;
            pts.Add((x, y));
        }
        return pts;
    }

    private string GetChartPath(bool area)
    {
        var pts = GetChartPoints();
        if (!pts.Any()) return "";
        var path = $"M {pts[0].x:F1},{pts[0].y:F1}";
        foreach (var pt in pts.Skip(1))
            path += $" L {pt.x:F1},{pt.y:F1}";
        if (area) path += $" L {pts.Last().x:F1},80 L {pts.First().x:F1},80 Z";
        return path;
    }
}
