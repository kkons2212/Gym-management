<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.SessionReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ĐỐI SOÁT &amp; XÁC NHẬN KẾT QUẢ BUỔI TẬP"
    PrimaryButtonText="Lưu Kết Quả"
    CloseButtonText="Hủy Bỏ"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16" Width="440">
        <!-- Session Info Card -->
        <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TxtSessionDetails" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="TxtScheduledTime" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Outcome Selector -->
        <StackPanel Spacing="6">
            <TextBlock Text="Kết quả buổi tập (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            <ComboBox x:Name="CboOutcome" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Hoàn thành buổi tập (Trừ 1 buổi của hội viên)" Tag="Completed" />
                <ComboBoxItem Content="Hội viên vắng mặt không phép (Trừ 1 buổi)" Tag="AbsentMember" />
                <ComboBoxItem Content="Huấn luyện viên vắng mặt (Không trừ buổi tập)" Tag="AbsentPt" />
                <ComboBoxItem Content="Hoãn / Dời ca tập (Không trừ buổi tập)" Tag="Postponed" />
            </ComboBox>
        </StackPanel>

        <!-- Notes -->
        <StackPanel Spacing="6">
            <TextBlock Text="Ghi chú xác nhận:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            <TextBox x:Name="TxtReviewNotes" PlaceholderText="Nhập lý do hoặc biên bản ghi nhận nếu có phát sinh..." HorizontalAlignment="Stretch" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

