<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.TrainerListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pt="using:GymManagement.Server.Core.DTOs.PT"
    Title="QUẢN LÝ DANH SÁCH HUẤN LUYỆN VIÊN"
    CloseButtonText="Đóng"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid Width="500" Height="480" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0"
                   Text="Xem danh sách, chỉ số đánh giá và cập nhật hồ sơ huấn luyện viên cá nhân."
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <!-- Toolbar: Search -->
        <AutoSuggestBox Grid.Row="1"
                        x:Name="AsbSearch"
                        PlaceholderText="Tìm theo tên HLV hoặc số điện thoại…"
                        QueryIcon="Find"
                        TextChanged="AsbSearch_TextChanged"
                        Height="36" />

        <!-- List View of Trainers -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <!-- Loading -->
                <ProgressBar x:Name="PbLoading" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" />

                <!-- Empty State -->
                <StackPanel x:Name="PnlEmpty" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Không tìm thấy huấn luyện viên nào phù hợp" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- List Content -->
                <ListView x:Name="LvTrainers" Padding="6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pt:PtProfileDto">
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,3" Padding="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar placeholder -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                            Background="#1E293B" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1.5"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{StaticResource AccentPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Trainer Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind FullName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Border CornerRadius="4" Padding="5,1" Background="#1E293B" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <TextBlock Text="HLV" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StatusPtBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{x:Bind Phone}" />
                                            <Run Text=" • " />
                                            <Run Text="{x:Bind Email}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Stats & Students -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                            <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#F59E0B" />
                                            <TextBlock Text="{x:Bind RatingAverage}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="(" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ReviewCount}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="đánh giá)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                            <TextBlock Text="Phụ trách:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ActiveStudentsCount}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" />
                                            <TextBlock Text="học viên" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
