<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.CancelSubscriptionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="XÁC NHẬN HỦY ĐĂNG KÝ GÓI TẬP"
    PrimaryButtonText="Xác Nhận Hủy Gói"
    CloseButtonText="Giữ Lại Gói"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16" Width="460">
        <!-- Warning Card -->
        <Border Background="#2D1214"
                BorderBrush="{StaticResource StatusDangerBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource StatusDangerBrush}" FontSize="16" />
                    <TextBlock Text="CẢNH BÁO QUAN TRỌNG" FontWeight="Bold" FontSize="13" Foreground="{StaticResource StatusDangerBrush}" />
                </StackPanel>
                <TextBlock Text="Thao tác này sẽ chấm dứt quyền sử dụng phòng tập của hội viên ngay lập tức. Toàn bộ lượt tập gym và ca PT còn lại sẽ bị hủy bỏ theo quy định. Tài khoản đăng nhập của khách hàng vẫn được bảo lưu."
                           FontSize="12"
                           Foreground="#FCA5A5"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Target Member & Plan -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Hội viên:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock x:Name="TxtMemberInfo" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Gói tập hiện tại:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock x:Name="TxtPlanName" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Mandatory Reason TextBox -->
        <StackPanel Spacing="4">
            <TextBlock Text="Lý do hủy gói (bắt buộc, tối thiểu 10 ký tự) *"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox x:Name="TxtReason"
                     PlaceholderText="Nhập lý do khách hàng yêu cầu hủy gói…"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80" />
        </StackPanel>

        <!-- Error Feedback -->
        <TextBlock x:Name="TxtValidationError"
                   Foreground="{StaticResource StatusDangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>

