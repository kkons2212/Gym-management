<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.VietQrPaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Thanh Toán VietQR Napas 247"
    PrimaryButtonText="In Phiếu Thu K80 (Enter)"
    CloseButtonText="Đóng"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16" Width="440">
        <!-- QR Code Container -->
        <Border Background="#FFFFFF" CornerRadius="12" Padding="16" HorizontalAlignment="Center" Width="260" Height="260">
            <Grid>
                <ProgressRing x:Name="QrLoadingRing" IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="QrImage" Stretch="Uniform" />
                <TextBlock x:Name="TxtQrError" Text="Không thể tải ảnh mã QR.&#x0a;Vui lòng quét bằng thông tin bên dưới."
                           Foreground="#DC2626" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Bank Info Box -->
        <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Số tiền:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                    <TextBlock x:Name="TxtAmount" Grid.Column="1" HorizontalAlignment="Right"
                               Foreground="{StaticResource StatusSuccessBrush}" FontSize="18" FontWeight="Bold" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ngân hàng:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                    <TextBlock x:Name="TxtBank" Grid.Column="1" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Số tài khoản:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                    <TextBlock x:Name="TxtAccount" Grid.Column="1" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nội dung:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                    <TextBlock x:Name="TxtContent" Grid.Column="1" HorizontalAlignment="Right"
                               Foreground="{StaticResource AccentPrimaryBrush}" FontSize="13" FontFamily="Consolas" FontWeight="Bold" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Payment Confirmation Action -->
        <StackPanel Spacing="8">
            <Button x:Name="BtnManualConfirm"
                    Content="✓ Xác nhận đã nhận tiền (Enter)"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    Background="{StaticResource StatusSuccessBrush}"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    Click="BtnManualConfirm_Click" />

            <TextBlock x:Name="TxtPaymentStatus"
                       Text="Đang chờ hội viên quét mã VietQR..."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
