<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.InBodyEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nhập Số Đo Sức Khỏe InBody"
    PrimaryButtonText="Lưu Chỉ Số (Ctrl+S)"
    CloseButtonText="Hủy Bỏ"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid ColumnSpacing="20" Width="520">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Inputs -->
        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock x:Name="TxtMemberInfo" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Chiều cao (cm):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <NumberBox x:Name="NbHeight" Value="170" Minimum="50" Maximum="250" SpinButtonPlacementMode="Inline" ValueChanged="OnInputMetricChanged" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Cân nặng (kg):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <NumberBox x:Name="NbWeight" Value="68" Minimum="20" Maximum="300" SpinButtonPlacementMode="Inline" ValueChanged="OnInputMetricChanged" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Tỷ lệ mỡ Body Fat (%):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <NumberBox x:Name="NbBodyFat" Value="18" Minimum="3" Maximum="60" SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Khối lượng cơ xương (kg):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <NumberBox x:Name="NbMuscle" Value="32" Minimum="10" Maximum="150" SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Ghi chú thể trạng:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <TextBox x:Name="TxtNotes" PlaceholderText="Ghi chú mục tiêu tập luyện..." Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
            </StackPanel>
        </StackPanel>

        <!-- Right Column: Real-time BMI Display -->
        <Border Grid.Column="1" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="CHỈ SỐ BMI" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                
                <TextBlock x:Name="TxtBmiValue" Text="23.5" FontSize="36" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" HorizontalAlignment="Center" />
                
                <Border x:Name="BrdBmiTag" Background="#16A34A" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtBmiClassification" Text="Bình thường (Chuẩn)" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                </Border>

                <TextBlock Text="Thước đo tiêu chuẩn:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" />
                <StackPanel Spacing="4">
                    <TextBlock Text="• &lt; 18.5: Thiếu cân (Gầy)" Foreground="#38BDF8" FontSize="10" />
                    <TextBlock Text="• 18.5 - 24.9: Chuẩn" Foreground="#22C55E" FontSize="10" />
                    <TextBlock Text="• 25.0 - 29.9: Thừa cân" Foreground="#F59E0B" FontSize="10" />
                    <TextBlock Text="• ≥ 30.0: Béo phì" Foreground="#EF4444" FontSize="10" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>

