<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.UserEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CẬP NHẬT TÀI KHOẢN &amp; PHÂN QUYỀN"
    PrimaryButtonText="Lưu Thay Đổi"
    CloseButtonText="Đóng"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="14" Width="440">
        <!-- Subtitle -->
        <TextBlock Text="Chỉnh sửa thông tin nhân sự và thiết lập vai trò truy cập hệ thống."
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <!-- Username / User Id (Read-only) -->
        <StackPanel Spacing="4">
            <TextBlock Text="Tên đăng nhập / Mã tài khoản" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox x:Name="TxtUserName" IsReadOnly="True" Height="36" />
        </StackPanel>

        <!-- Full Name -->
        <StackPanel Spacing="4">
            <TextBlock Text="Họ và tên *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox x:Name="TxtFullName" PlaceholderText="Nhập họ và tên..." Height="36" />
        </StackPanel>

        <!-- Email & Phone -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Số điện thoại *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="TxtPhone" PlaceholderText="0901234567" Height="36" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Địa chỉ Email *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="TxtEmail" PlaceholderText="email@gymsystem.vn" Height="36" />
            </StackPanel>
        </Grid>

        <!-- Role Selector -->
        <StackPanel Spacing="4">
            <TextBlock Text="Vai trò truy cập (Role) *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox x:Name="CboRole" HorizontalAlignment="Stretch" Height="36">
                <ComboBoxItem x:Name="CbiAdminRole" Content="Quản trị viên (Admin)" Tag="Admin" />
                <ComboBoxItem Content="Huấn luyện viên cá nhân (PT)" Tag="PT" />
                <ComboBoxItem Content="Nhân viên quầy lễ tân (Staff)" Tag="Staff" />
            </ComboBox>
        </StackPanel>

        <!-- Self-demotion Guardrail Notice -->
        <Border x:Name="PnlSelfNotice"
                Background="#3B2610"
                BorderBrush="{StaticResource StatusWarningBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource StatusWarningBrush}" />
                <TextBlock Text="Không thể tự thay đổi vai trò của tài khoản đang đăng nhập."
                           Foreground="{StaticResource StatusWarningBrush}"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Loading indicator -->
        <ProgressRing x:Name="PrSaving" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Width="28" Height="28" />

        <!-- Validation Error Info -->
        <Border x:Name="PnlValidationError"
                Background="#3D1212"
                BorderBrush="{StaticResource StatusDangerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtValidationError"
                       Foreground="#FCA5A5"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</ContentDialog>

