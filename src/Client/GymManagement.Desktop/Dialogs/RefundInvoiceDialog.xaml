<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.RefundInvoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xử Lý Hoàn Tiền Hóa Đơn (Refund)"
    PrimaryButtonText="Xác Nhận Hoàn Tiền"
    CloseButtonText="Hủy Bỏ"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16" Width="440">
        <!-- Warning Info -->
        <Border Background="#331414" BorderBrush="{StaticResource StatusDangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="4">
                <TextBlock Text="CẢNH BÁO HOÀN HÓA ĐƠN &amp; THU HỒI GÓI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StatusDangerBrush}" />
                <TextBlock Text="Xác nhận hoàn tiền sẽ chuyển trạng thái hóa đơn sang REFUNDED, thu hồi quyền lợi gói tập tương ứng và ghi nhận giảm trừ doanh thu."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Invoice Info Card -->
        <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Mã hóa đơn:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtInvoiceCode" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Số tiền gốc:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtOriginalAmount" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Refund Amount -->
        <StackPanel Spacing="6">
            <TextBlock Text="Số tiền hoàn (VNĐ) (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            <TextBox x:Name="TxtRefundAmount" PlaceholderText="Nhập số tiền cần hoàn..." HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Refund Method -->
        <StackPanel Spacing="6">
            <TextBlock Text="Hình thức hoàn tiền (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            <ComboBox x:Name="CboRefundMethod" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Tiền mặt (CASH)" Tag="CASH" />
                <ComboBoxItem Content="Chuyển khoản (BANK_TRANSFER)" Tag="BANK_TRANSFER" />
            </ComboBox>
        </StackPanel>

        <!-- Refund Reason -->
        <StackPanel Spacing="6">
            <TextBlock Text="Lý do hoàn tiền (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            <TextBox x:Name="TxtReason" PlaceholderText="Nhập lý do hoàn tiền bắt buộc..." HorizontalAlignment="Stretch" />
        </StackPanel>

        <TextBlock x:Name="TxtValidationError" Foreground="{StaticResource StatusDangerBrush}" FontSize="12" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>

