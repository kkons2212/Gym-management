<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.PackagePlanEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CHỈNH SỬA GÓI TẬP"
    PrimaryButtonText="Lưu Thay Đổi"
    CloseButtonText="Đóng"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="14" Width="460">
        <!-- Subtitle -->
        <TextBlock Text="Cập nhật thông số giá, thời hạn, quyền lợi và trạng thái của gói dịch vụ."
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <!-- Plan ID (Read-only) -->
        <StackPanel Spacing="4">
            <TextBlock Text="Mã định danh gói tập" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox x:Name="TxtPlanId" IsReadOnly="True" Height="36" />
        </StackPanel>

        <!-- Name -->
        <StackPanel Spacing="4">
            <TextBlock Text="Tên gói tập *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox x:Name="TxtName" PlaceholderText="Ví dụ: Gói 3 Tháng Thể Thao" Height="36" />
        </StackPanel>

        <!-- Description -->
        <StackPanel Spacing="4">
            <TextBlock Text="Mô tả quyền lợi" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox x:Name="TxtDescription" PlaceholderText="Mô tả chi tiết..." Height="54" TextWrapping="Wrap" AcceptsReturn="True" />
        </StackPanel>

        <!-- Price & Status -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Đơn giá niêm yết (VNĐ) *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <NumberBox x:Name="NbPrice" Minimum="0" SpinButtonPlacementMode="Inline" Height="36" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Trạng thái kinh doanh" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox x:Name="CboStatus" HorizontalAlignment="Stretch" Height="36">
                    <ComboBoxItem Content="Đang kinh doanh" Tag="ACTIVE" IsSelected="True" />
                    <ComboBoxItem Content="Tạm dừng" Tag="INACTIVE" />
                    <ComboBoxItem Content="Ngừng kinh doanh" Tag="DISCONTINUED" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Duration & Max Check-in -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Thời hạn (ngày) *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <NumberBox x:Name="NbDurationDays" Minimum="1" SpinButtonPlacementMode="Inline" Height="36" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Lượt gym tối đa" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <NumberBox x:Name="NbMaxCheckInSessions" Minimum="1" SpinButtonPlacementMode="Inline" Height="36" />
            </StackPanel>
        </Grid>

        <!-- PT inclusion -->
        <CheckBox x:Name="CbIsPtIncluded" Content="Bao gồm buổi tập kèm PT" Checked="CbIsPtIncluded_CheckedChanged" Unchecked="CbIsPtIncluded_CheckedChanged" />

        <StackPanel x:Name="PnlPtSessions" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="Số buổi PT kèm theo" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <NumberBox x:Name="NbTotalPtSessions" Minimum="0" SpinButtonPlacementMode="Inline" Height="36" />
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressRing x:Name="PrSaving" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Width="28" Height="28" />

        <!-- Validation Error Info -->
        <Border x:Name="PnlValidationError"
                Background="#3D1212"
                BorderBrush="{StaticResource StatusDangerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtValidationError"
                       Foreground="#FCA5A5"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</ContentDialog>

