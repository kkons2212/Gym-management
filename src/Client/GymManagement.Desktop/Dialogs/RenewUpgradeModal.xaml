<ContentDialog
    x:Class="GymManagement.Desktop.Dialogs.RenewUpgradeModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GIA HẠN / NÂNG CẤP GÓI TẬP"
    PrimaryButtonText="Xác Nhận Thanh Toán"
    CloseButtonText="Hủy Bỏ"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16" Width="500">
        <!-- Current Subscription Summary Card -->
        <Border Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TxtMemberInfo"
                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCurrentPlan"
                           HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}" />

                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtCurrentEndDate"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRemainingSessions"
                           HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource StatusSuccessBrush}" />
            </Grid>
        </Border>

        <!-- Operation Mode: Renew vs Upgrade -->
        <StackPanel Spacing="6">
            <TextBlock Text="Chọn hình thức thực hiện:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <RadioButton x:Name="RbRenew" Content="Gia Hạn Gói Hiện Tại" IsChecked="True" Checked="OnModeChanged" />
                <RadioButton x:Name="RbUpgrade" Content="Nâng Cấp Lên Gói Khác" Checked="OnModeChanged" />
            </StackPanel>
        </StackPanel>

        <!-- Package Selection -->
        <StackPanel x:Name="PnlSelectPackage" Spacing="4">
            <TextBlock x:Name="LblSelectPackage" Text="Chọn gói tập:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox x:Name="CboPackages"
                      HorizontalAlignment="Stretch"
                      Height="36"
                      SelectionChanged="CboPackages_SelectionChanged" />
        </StackPanel>

        <!-- Payment Calculation Card -->
        <Border Background="#111827"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="TỔNG TIỀN THANH TOÁN:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Đơn giá niêm yết cố định (0 chiết khấu)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtPaymentAmount"
                           Text="0 VNĐ"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource StatusSuccessBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Payment Method Selection -->
        <StackPanel Spacing="6">
            <TextBlock Text="Phương thức thu tiền:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton x:Name="RbCash" Content="Tiền Mặt" IsChecked="True" />
                <RadioButton x:Name="RbVietQr" Content="Chuyển Khoản VietQR" />
            </StackPanel>
        </StackPanel>

        <!-- Error Feedback -->
        <TextBlock x:Name="TxtError"
                   Foreground="{StaticResource StatusDangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>

