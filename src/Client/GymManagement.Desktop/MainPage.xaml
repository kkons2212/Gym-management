<Page
    x:Class="GymManagement.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    Background="{StaticResource BgCanvasBrush}">

    <Grid>
        <NavigationView x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="280"
                        CompactPaneLength="48"
                        SelectionChanged="NavView_SelectionChanged">
            <!-- Header -->
            <NavigationView.PaneHeader>
                <Border Padding="16,14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="GYM MANAGEMENT"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   CharacterSpacing="100" />
                        <TextBlock Text="Cổng Quản Trị Viên"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneHeader>

            <!-- Menu Items: 7 Functional Modules per PRD & ui_rules.md 3.1 -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Quầy Điểm Danh &amp; Cổng Tự Động" Tag="CheckIn">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Bán Gói &amp; Thanh Toán POS (F2)" Tag="Pos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Lịch Sử &amp; In Hóa Đơn (F6)" Tag="Invoices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Quản Lý Hội Viên &amp; Gói Tập (F3)" Tag="Members">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Lịch Biểu HLV PT (F5)" Tag="Schedule">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Báo Cáo &amp; Thống Kê Doanh Thu" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Quản Lý Nhân Sự (RBAC)" Tag="Staff">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Danh Mục Gói Dịch Vụ" Tag="Packages">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Footer: Current Admin & Logout -->
            <NavigationView.PaneFooter>
                <Border Padding="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ShellVm.AdminDisplayName, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="#16A34A" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ShellVm.AdminRoleName, Mode=OneWay}"
                                           FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1"
                                ToolTipService.ToolTip="Đăng xuất"
                                Click="BtnLogout_Click"
                                Background="Transparent" BorderThickness="0"
                                Padding="8">
                            <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Main Content Area -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Page>
