<Page
    x:Class="GymManagement.Desktop.Views.PosBillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    xmlns:converters="using:GymManagement.Desktop.Converters"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.Packages"
    xmlns:memdto="using:GymManagement.Server.Core.DTOs.Members"
    Background="{StaticResource BgCanvasBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/ColorTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:CurrencyFormatterConverter x:Key="CurrencyFormatterConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Package Plans Catalog -->
        <Grid Grid.Column="0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search & Title -->
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="DANH MỤC GÓI TẬP NIÊM YẾT"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Bấm chọn gói tập để nạp vào hóa đơn thanh toán (F2)"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Packages ListView -->
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Packages}"
                      SelectionChanged="OnPackageSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PackagePlanDto">
                        <Border Background="{StaticResource BgSurfaceBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,4"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Name & Duration -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- Benefit Details -->
                                <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Text="{x:Bind Description}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Border Background="#0F172A" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind DurationDays, Converter={StaticResource StringFormatConverter}}" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" />
                                        </Border>
                                        <Border Background="#0F172A" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind MaxCheckInSessions, Converter={StaticResource StringFormatConverter}}" FontSize="11" Foreground="{StaticResource StatusSuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Price -->
                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind Price, Converter={StaticResource CurrencyFormatterConverter}}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource StatusSuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Right Column: Cart & Billing Checkout -->
        <Border Grid.Column="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Section Title -->
                <TextBlock Grid.Row="0" Text="HÓA ĐƠN BÁN HÀNG POS"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <!-- Select Member -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="Hội viên thanh toán:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <ComboBox x:Name="CbMembers"
                              ItemsSource="{x:Bind ViewModel.Members}"
                              SelectedItem="{x:Bind ViewModel.SelectedMember, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="memdto:MemberDto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold" />
                                    <TextBlock Text="•" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Phone}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Transaction Type Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <RadioButton Content="Mua mới" IsChecked="True" GroupName="TxType" Checked="OnPurchaseSelected" />
                        <RadioButton Content="Gia hạn gói" GroupName="TxType" Checked="OnRenewalSelected" />
                    </StackPanel>
                </StackPanel>

                <!-- Invoice Breakdown Line Items -->
                <Border Grid.Row="2"
                        Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <ScrollViewer>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Chi tiết gói tập:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedPackageName, Mode=OneWay}"
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedPackageDescription, Mode=OneWay}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,6" />

                            <Grid>
                                <TextBlock Text="Thời hạn sử dụng:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedPackageDurationDays, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                            </Grid>

                            <Grid>
                                <TextBlock Text="Số buổi Gym:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedPackageMaxCheckInSessions, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                            </Grid>

                            <Grid>
                                <TextBlock Text="Buổi PT kèm:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedPackageTotalPtSessions, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,6" />

                            <Grid>
                                <TextBlock Text="Tạm tính (Subtotal):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.SubtotalAmount, Mode=OneWay, Converter={StaticResource CurrencyFormatterConverter}}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            </Grid>

                            <!-- STRICT RULE: NO DISCOUNT ROW. Total = Subtotal = Package Price -->
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="TỔNG THANH TOÁN:" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyFormatterConverter}}"
                                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Payment Methods -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <TextBlock Text="Phương thức thanh toán:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnCash" Grid.Column="0" Content="💵 Tiền Mặt"
                                HorizontalAlignment="Stretch" Height="40"
                                Click="BtnPaymentMethod_Click" Tag="CASH" />
                        <Button x:Name="BtnVietQr" Grid.Column="1" Content="📱 VietQR"
                                HorizontalAlignment="Stretch" Height="40"
                                Background="{StaticResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                Click="BtnPaymentMethod_Click" Tag="VIETQR" />
                        <Button x:Name="BtnCard" Grid.Column="2" Content="💳 Quẹt Thẻ"
                                HorizontalAlignment="Stretch" Height="40"
                                Click="BtnPaymentMethod_Click" Tag="CREDIT_CARD" />
                    </Grid>

                    <TextBlock x:Name="TxtStatus" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="{StaticResource StatusWarningBrush}" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Process Checkout Button -->
                <Button Grid.Row="4"
                        Content="Thanh Toán &amp; Xuất Hóa Đơn (Enter)"
                        Command="{x:Bind ViewModel.ProcessCheckoutCommand}"
                        Click="OnProcessCheckoutClicked"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        Background="{StaticResource StatusSuccessBrush}"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="15"
                        CornerRadius="8" />
            </Grid>
        </Border>
    </Grid>
</Page>
