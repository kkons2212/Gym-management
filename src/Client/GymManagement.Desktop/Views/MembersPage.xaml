<Page
    x:Class="GymManagement.Desktop.Views.MembersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    xmlns:converters="using:GymManagement.Desktop.Converters"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.Members"
    Background="{StaticResource BgCanvasBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/ColorTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:CurrencyFormatterConverter x:Key="CurrencyFormatterConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title & Action (Standard Terminology: Gói Tập) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="QUẢN LÝ HỘI VIÊN &amp; GÓI TẬP"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tra cứu thông tin, bảo lưu gói tập và ghi nhận số đo InBody (F3)"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="+ Đăng Ký Hội Viên Mới"
                    Click="BtnRegisterNewMember_Click"
                    Background="{StaticResource AccentPrimaryBrush}"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    Height="40"
                    Padding="16,0" />
        </Grid>

        <!-- Search Bar & Status Filter -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <AutoSuggestBox x:Name="AsbSearch"
                            PlaceholderText="Tìm kiếm theo Họ tên, SĐT, hoặc Mã hội viên..."
                            Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay}"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            Height="40" />

            <!-- Status Filter Buttons (Plain Text Status, No Icons per ui_rules.md) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Tất cả" Tag="ALL" Click="OnFilterClicked" Height="40" />
                <Button Content="Đang hoạt động" Tag="ACTIVE" Click="OnFilterClicked" Height="40" Foreground="{StaticResource StatusSuccessBrush}" />
                <Button Content="Đang bảo lưu" Tag="FROZEN" Click="OnFilterClicked" Height="40" Foreground="{StaticResource StatusWarningBrush}" />
                <Button Content="Đã hết hạn" Tag="EXPIRED" Click="OnFilterClicked" Height="40" Foreground="{StaticResource StatusDangerBrush}" />
            </StackPanel>
        </Grid>

        <!-- Members Table / ListView -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="#0F172A" CornerRadius="12,12,0,0" Padding="20,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="3.2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HỘI VIÊN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="GÓI TẬP HIỆN TẠI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="HẠN SỬ DỤNG" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="BUỔI CÒN LẠI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="THAO TÁC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Loading Indicator -->
                <ProgressBar Grid.Row="0" IsIndeterminate="True" VerticalAlignment="Bottom"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Empty State -->
                <Border Grid.Row="1" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="60,40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Chưa có hội viên nào trong danh sách"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Table Content -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Members}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MemberDto">
                            <Grid Padding="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="3.2*" />
                                </Grid.ColumnDefinitions>

                                <!-- Member Name & Phone -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Phone}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>

                                <!-- Active Plan -->
                                <TextBlock Grid.Column="1" Text="{x:Bind ActivePlanName}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}" />

                                <!-- End Date -->
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{x:Bind EndDate, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" />

                                <!-- Remaining Sessions -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind RemainingCheckInSessions, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource StatusSuccessBrush}" />
                                    <TextBlock Text="{x:Bind RemainingPtSessions, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontSize="11" Foreground="{StaticResource StatusPtBrush}" />
                                </StackPanel>

                                <!-- Status Chip (Pure text, no icon) -->
                                <Border Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="12" Padding="8,4">
                                    <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>

                                <!-- Actions Toolbar (UC02, UC04) -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Sửa" Click="OnEditProfileClicked" Height="30" FontSize="11" Padding="8,2" />
                                    <Button Content="Gia Hạn" Click="OnRenewUpgradeClicked" Height="30" FontSize="11" Padding="8,2"
                                            Background="{StaticResource AccentFillColorDefaultBrush}" Foreground="#FFFFFF" />
                                    <DropDownButton Content="Thao tác…" Height="30" FontSize="11" Padding="8,2">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Phân công PT" Click="OnAssignPtClicked" Icon="Contact" />
                                                <MenuFlyoutItem Text="Bảo lưu gói tập" Click="OnFreezeClicked" Icon="Pause" />
                                                <MenuFlyoutItem Text="Đo InBody" Click="OnInBodyClicked" Icon="ReportHacked" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Hủy đăng ký gói" Click="OnCancelSubscriptionClicked" Icon="Cancel" Foreground="{StaticResource StatusDangerBrush}" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
