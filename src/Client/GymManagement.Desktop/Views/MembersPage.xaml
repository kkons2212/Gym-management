<Page
    x:Class="GymManagement.Desktop.Views.MembersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="QUẢN LÝ HỘI VIÊN &amp; GÓI TẬP"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tra cứu thông tin, bảo lưu gói tập và ghi nhận số đo InBody (F3)"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="+ Đăng Ký Hội Viên Mới"
                    Click="BtnRegisterNewMember_Click"
                    Background="{StaticResource AccentPrimaryBrush}"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    Height="40"
                    Padding="16,0" />
        </Grid>

        <!-- Search Bar & Status Filter -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="QUẢN LÝ HỘI VIÊN &amp; GÓI TẬP"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Canvas sạch sẵn sàng tái cấu trúc giao diện theo ui_rules.md &amp; ux_rules.md (UC02)"
                           FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- CTA Button: + Đăng Ký Hội Viên Mới (per ui_rules.md 3.4) -->
            <Button Grid.Column="1"
                    Content="+ Đăng Ký Hội Viên Mới"
                    Height="38"
                    Padding="16,0"
                    Background="{StaticResource AccentFillColorDefaultBrush}"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    CornerRadius="8" />
        </Grid>

        <!-- Blank Workspace -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="[Vùng thiết kế bảng hội viên cuộn ảo &amp; hộp thoại Wizard đăng ký 2 bước]"
                           Foreground="{StaticResource TextFillColorTertiaryBrush}"
                           FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</Page>
