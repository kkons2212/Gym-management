<Page
    x:Class="GymManagement.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    xmlns:converters="using:GymManagement.Desktop.Converters"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.Identity"
    Background="{StaticResource BgCanvasBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/ColorTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:CurrencyFormatterConverter x:Key="CurrencyFormatterConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Add User Form & System Info -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <ScrollViewer>
                <StackPanel Spacing="16">
                    <TextBlock Text="QUẢN LÝ TÀI KHOẢN HỆ THỐNG"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <!-- Admin Info Badge -->
                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Đang đăng nhập với vai trò:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentAdminName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#16A34A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.CurrentAdminRole}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Thêm tài khoản nhân viên / HLV:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Tên đăng nhập (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBox Text="{x:Bind ViewModel.NewUsername, Mode=TwoWay}" PlaceholderText="tên_đăng_nhập" Height="38" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Họ và tên (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBox Text="{x:Bind ViewModel.NewFullName, Mode=TwoWay}" PlaceholderText="Nhập họ và tên..." Height="38" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Email (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBox Text="{x:Bind ViewModel.NewEmail, Mode=TwoWay}" PlaceholderText="email@gymsystem.vn" Height="38" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Số điện thoại (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBox Text="{x:Bind ViewModel.NewPhone, Mode=TwoWay}" PlaceholderText="0901234567" Height="38" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Mật khẩu (*):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <PasswordBox x:Name="PbNewPassword" PasswordChanged="OnNewPasswordChanged" PlaceholderText="Nhập mật khẩu (tối thiểu 6 ký tự)..." Height="38" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Vai trò (Role):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <ComboBox x:Name="RoleComboBox" SelectionChanged="OnRoleSelectionChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Huấn luyện viên cá nhân (PT)" Tag="PT" />
                            <ComboBoxItem x:Name="AdminRoleOption" Content="Quản trị viên (Admin)" Tag="Admin"
                                          Visibility="{x:Bind ViewModel.IsSuperAdmin, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <Button Content="Tạo Tài Khoản"
                            Command="{x:Bind ViewModel.CreateUserCommand}"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            FontSize="14"
                            CornerRadius="8" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Column: User Accounts List -->
        <Border Grid.Column="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="DANH SÁCH TÀI KHOẢN VẬN HÀNH"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Danh sách người dùng có quyền truy cập hệ thống (Admin &amp; PT)"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Tải Lại"
                            Command="{x:Bind ViewModel.LoadUsersCommand}"
                            Height="36" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Users}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:UserSessionDto">
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="10" Margin="0,6" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- User Info -->
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Bind FullName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Email}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Role Chip -->
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                            Background="#1E293B" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="{x:Bind Role}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                                    </Border>

                                    <!-- Actions: Sửa & Khóa/Mở -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Sửa" Click="OnEditUserClicked" Height="34" FontSize="12" Padding="12,0" />
                                        <Button Content="Khóa / Mở" Click="OnToggleLockClicked" Height="34" FontSize="12"
                                                Background="#3D1212" BorderBrush="{StaticResource StatusDangerBrush}" BorderThickness="1"
                                                Foreground="{StaticResource StatusDangerBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
