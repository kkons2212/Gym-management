<Page
    x:Class="GymManagement.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    xmlns:converters="using:GymManagement.Desktop.Converters"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.Reports"
    Background="{StaticResource BgCanvasBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/ColorTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:CurrencyFormatterConverter x:Key="CurrencyFormatterConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="4">
                <TextBlock Text="BÁO CÁO &amp; THỐNG KÊ DOANH THU BI"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tổng quan chỉ số kinh doanh, tỷ trọng gói tập và lưu lượng check-in theo giờ"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Click="OnExportExcelClicked"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        Height="38">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="#10B981" />
                        <TextBlock Text="Xuất Excel (.xlsx)" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Click="OnExportPdfClicked"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        Height="38">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEA90;" FontSize="14" Foreground="#EF4444" />
                        <TextBlock Text="Xuất PDF (.pdf)" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.LoadDashboardCommand}"
                        Background="{StaticResource AccentPrimaryBrush}"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Height="38">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="#FFFFFF" />
                        <TextBlock Text="Làm Mới" FontSize="13" Foreground="#FFFFFF" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 4 Flat KPI Cards Grid -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Revenue -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="DOANH THU HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayRevenue, Mode=OneWay, Converter={StaticResource CurrencyFormatterConverter}}"
                               FontSize="24" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" />
                    <TextBlock Text="Hóa đơn đã ghi nhận" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Check-ins -->
            <Border Grid.Column="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="LƯỢT CHECK-IN HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayCheckIns, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                               FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                    <TextBlock Text="Lượt qua cổng Turnstile" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 3: New Members -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="HỘI VIÊN MỚI THÁNG NÀY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.NewMembersThisMonth, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                               FontSize="24" FontWeight="Bold" Foreground="{StaticResource StatusWarningBrush}" />
                    <TextBlock Text="Đăng ký tài khoản mới" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 4: PT Sessions -->
            <Border Grid.Column="3"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="BUỔI PT HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CompletedPtSessions, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                               FontSize="24" FontWeight="Bold" Foreground="{StaticResource StatusPtBrush}" />
                    <TextBlock Text="Ca huấn luyện viên cá nhân" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- BI Detail Row: Left = Peak Hours, Right = Package Revenue Distribution -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Peak Hour Traffic Breakdown -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="LƯU LƯỢNG CHECK-IN THEO GIỜ" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Phân bố mật độ hội viên qua cổng (Cao điểm 17:00 - 20:00)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Hourly Bars -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PeakHours}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:PeakHourTrafficDto">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind Hour, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                        <Border Grid.Column="1" Height="16" Background="#0F172A" CornerRadius="4" HorizontalAlignment="Stretch">
                                            <ProgressBar Value="{x:Bind CheckInCount, Mode=OneWay}" Maximum="60"
                                                         Foreground="{StaticResource AccentPrimaryBrush}" Background="Transparent"
                                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{x:Bind CheckInCount, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                                                   FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Revenue Distribution Breakdown by Package & Payment Method -->
            <Border Grid.Column="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="CƠ CẤU DOANH THU THEO GÓI TẬP" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Tỷ trọng doanh thu theo các gói dịch vụ kinh doanh" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Package Breakdown List -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PackageRevenues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:PackageRevenueDto">
                                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,4" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind PlanName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Đã đăng ký:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind SubscriptionCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                    <TextBlock Text="lượt" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyFormatterConverter}}"
                                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource StatusSuccessBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Payment Methods Summary -->
                    <Border Grid.Row="2" Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="HÌNH THỨC THANH TOÁN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PaymentMethodRevenues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:PaymentMethodRevenueDto">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind PaymentMethod}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="(" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Percentage}" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                <TextBlock Text="%)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyFormatterConverter}}"
                                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
