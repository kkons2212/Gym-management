<Page
    x:Class="GymManagement.Desktop.Views.InvoiceHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.Billing"
    Background="{StaticResource BgCanvasBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="4">
                <TextBlock Text="LỊCH SỬ HÓA ĐƠN &amp; IN PHIẾU THU"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tra cứu lịch sử giao dịch, in lại phiếu thu nhiệt K80 và xử lý yêu cầu hoàn tiền"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Notification Banner / InfoBar -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 Severity="Informational"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsClosable="True" />

        <!-- Filter & Search Toolbar -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <AutoSuggestBox Grid.Column="0"
                            PlaceholderText="Tìm theo mã hóa đơn hoặc tên hội viên…"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            Height="40" />

            <!-- Status Segmented Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Tất cả" Tag="ALL" Click="OnFilterClicked" Height="40" />
                <Button Content="Đã thanh toán" Tag="PAID" Click="OnFilterClicked" Height="40" Foreground="{StaticResource StatusSuccessBrush}" />
                <Button Content="Đã hoàn tiền" Tag="REFUNDED" Click="OnFilterClicked" Height="40" Foreground="{StaticResource StatusDangerBrush}" />
            </StackPanel>

            <!-- Refresh Button -->
            <Button Grid.Column="2" Click="OnRefreshClicked" Height="40" ToolTipService.ToolTip="Làm mới danh sách">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Làm mới" FontSize="13" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Invoices Table -->
        <Border Grid.Row="3"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="#0F172A" CornerRadius="12,12,0,0" Padding="16,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*" MinWidth="130" />
                            <ColumnDefinition Width="1.6*" MinWidth="110" />
                            <ColumnDefinition Width="2*" MinWidth="140" />
                            <ColumnDefinition Width="2*" MinWidth="130" />
                            <ColumnDefinition Width="1.6*" MinWidth="110" />
                            <ColumnDefinition Width="1.4*" MinWidth="90" />
                            <ColumnDefinition Width="1.4*" MinWidth="90" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MÃ HÓA ĐƠN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="THỜI GIAN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="KHÁCH HÀNG" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="GÓI DỊCH VỤ" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="TỔNG TIỀN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="HÌNH THỨC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="6" Text="TRẠNG THÁI" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="7" Text="THAO TÁC" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Loading Indicator -->
                <ProgressBar Grid.Row="0" IsIndeterminate="True" VerticalAlignment="Bottom"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Empty State -->
                <Border Grid.Row="1" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="60,40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8A1;" FontSize="40" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Không tìm thấy hóa đơn nào phù hợp"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Table Content -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Invoices}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:InvoiceDto">
                            <Grid Padding="16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" MinWidth="130" />
                                    <ColumnDefinition Width="1.6*" MinWidth="110" />
                                    <ColumnDefinition Width="2*" MinWidth="140" />
                                    <ColumnDefinition Width="2*" MinWidth="130" />
                                    <ColumnDefinition Width="1.6*" MinWidth="110" />
                                    <ColumnDefinition Width="1.4*" MinWidth="90" />
                                    <ColumnDefinition Width="1.4*" MinWidth="90" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <!-- Invoice Code -->
                                <TextBlock Grid.Column="0" Text="{x:Bind InvoiceCode}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />

                                <!-- Created At / Paid At -->
                                <TextBlock Grid.Column="1" Text="{x:Bind PaidAt, Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- Member Name -->
                                <TextBlock Grid.Column="2" Text="{x:Bind MemberName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                <!-- Plan Name -->
                                <TextBlock Grid.Column="3" Text="{x:Bind PlanName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                <!-- Total Amount -->
                                <TextBlock Grid.Column="4" Text="{x:Bind TotalAmount, Converter={StaticResource CurrencyFormatterConverter}}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center" />

                                <!-- Payment Method -->
                                <TextBlock Grid.Column="5" Text="{x:Bind PaymentMethod}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <!-- Status Chip -->
                                <Border Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="12" Padding="8,4">
                                    <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="In K80" Click="OnPrintReceiptClicked" Height="30" FontSize="11" Padding="8,2" />
                                    <Button Content="Hoàn Tiền" Click="OnRefundInvoiceClicked" Height="30" FontSize="11" Padding="8,2"
                                            Background="#3B2610" BorderBrush="{StaticResource StatusWarningBrush}" BorderThickness="1"
                                            Foreground="{StaticResource StatusWarningBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

