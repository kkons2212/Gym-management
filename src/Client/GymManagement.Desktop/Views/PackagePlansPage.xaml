<Page
    x:Class="GymManagement.Desktop.Views.PackagePlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    xmlns:converters="using:GymManagement.Desktop.Converters"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.Packages"
    Background="{StaticResource BgCanvasBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/ColorTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:CurrencyFormatterConverter x:Key="CurrencyFormatterConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Create New Package Form -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <ScrollViewer>
                <StackPanel Spacing="16">
                    <TextBlock Text="THIẾT LẬP GÓI TẬP MỚI"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Tên gói tập:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{x:Bind ViewModel.NewName, Mode=TwoWay}" PlaceholderText="Ví dụ: Gói 3 Tháng Thể Thao" Height="38" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Mô tả quyền lợi:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{x:Bind ViewModel.NewDescription, Mode=TwoWay}" PlaceholderText="Quyền lợi gói tập..." Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Đơn giá niêm yết (VNĐ):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <NumberBox Value="{x:Bind ViewModel.NewPrice, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" Height="38" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Thời hạn (ngày):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <NumberBox Value="{x:Bind ViewModel.NewDurationDays, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" Height="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Lượt gym tối đa:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <NumberBox Value="{x:Bind ViewModel.NewMaxCheckInSessions, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" Height="38" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Bao gồm buổi tập kèm PT"
                              IsChecked="{x:Bind ViewModel.NewIsPtIncluded, Mode=TwoWay}" />

                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.NewIsPtIncluded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Số buổi PT kèm theo:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <NumberBox Value="{x:Bind ViewModel.NewTotalPtSessions, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Inline" Height="38" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <Button Content="Tạo Gói Tập"
                            Command="{x:Bind ViewModel.CreatePackageCommand}"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            FontSize="14"
                            CornerRadius="8" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Column: Existing Package Plans List -->
        <Border Grid.Column="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="DANH SÁCH GÓI TẬP ĐANG LƯU HÀNH"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Tất cả các gói dịch vụ phòng tập và huấn luyện viên"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Tải Lại"
                            Command="{x:Bind ViewModel.LoadPackagesCommand}"
                            Height="36" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Packages}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:PackagePlanDto">
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="10" Margin="0,6" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Plan Info -->
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind PlanId}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind DurationDays, Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                <TextBlock Text="ngày" FontSize="12" Foreground="{StaticResource AccentPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="•" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind MaxCheckInSessions, Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="{StaticResource StatusSuccessBrush}" />
                                            <TextBlock Text="buổi Gym" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="•" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind TotalPtSessions, Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="{StaticResource StatusPtBrush}" />
                                            <TextBlock Text="buổi PT" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Price, Status & Actions -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="{x:Bind Price, Converter={StaticResource CurrencyFormatterConverter}}"
                                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}"
                                                   HorizontalAlignment="Right" />
                                        <Border Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}}"
                                                CornerRadius="10" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Button Content="Sửa" Click="OnEditPackageClicked" Height="30" FontSize="11" Padding="10,0" />
                                            <Button Content="Xóa" Click="OnDeletePackageClicked" Height="30" FontSize="11" Padding="10,0"
                                                    Background="#3D1212" BorderBrush="{StaticResource StatusDangerBrush}" BorderThickness="1"
                                                    Foreground="{StaticResource StatusDangerBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
