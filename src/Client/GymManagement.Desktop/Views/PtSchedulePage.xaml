<Page
    x:Class="GymManagement.Desktop.Views.PtSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="LỊCH BIỂU HUẤN LUYỆN VIÊN PT"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Canvas sạch sẵn sàng tái cấu trúc giao diện theo ui_rules.md &amp; ux_rules.md (UC04)"
                       FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Blank Workspace -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="LỊCH TRÌNH DẠY THEO TUẦN"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Các ca tập đã xếp của huấn luyện viên trong khung giờ 06:00 - 22:00"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="Tải Lại Lịch"
                            Command="{x:Bind ViewModel.LoadScheduleCommand}"
                            HorizontalAlignment="Right" Height="36" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ScheduledSlots}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:PtSessionSlotDto">
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Time Slot -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ScheduledDate, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind StartTime, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" />
                                            <TextBlock Text="-" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind EndTime, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Member & PT -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind MemberName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind PtName}" FontSize="13" Foreground="{StaticResource StatusPtBrush}" />
                                    </StackPanel>

                                    <!-- Status Tag & Review Action -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="#1E293B" BorderBrush="{StaticResource StatusPtBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="{x:Bind SessionStatus}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatusPtBrush}" />
                                        </Border>
                                        <Button Content="Đối soát" Click="BtnReviewSession_Click" Height="32" FontSize="11" Padding="8,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
