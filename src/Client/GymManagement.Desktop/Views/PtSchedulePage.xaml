<Page
    x:Class="GymManagement.Desktop.Views.PtSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    xmlns:converters="using:GymManagement.Desktop.Converters"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.PTSchedules"
    xmlns:userdto="using:GymManagement.Server.Core.DTOs.Identity"
    xmlns:memdto="using:GymManagement.Server.Core.DTOs.Members"
    Background="{StaticResource BgCanvasBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/ColorTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:CurrencyFormatterConverter x:Key="CurrencyFormatterConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: PT Selector & Booking Guardrail -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <ScrollViewer>
                <StackPanel Spacing="16">
                    <TextBlock Text="ĐIỀU PHỐI LỊCH HUẤN LUYỆN VIÊN"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <!-- Select PT -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Huấn luyện viên phụ trách:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailablePts}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPt, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="userdto:UserSessionDto">
                                    <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Select Date -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Ngày dạy:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <DatePicker Date="{x:Bind ViewModel.SelectedDate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Select Member -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Hội viên đặt ca:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailableMembers}"
                                  SelectedItem="{x:Bind ViewModel.SelectedMember, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="memdto:MemberDto">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold" />
                                        <TextBlock Text="• Còn" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind RemainingPtSessions, Converter={StaticResource StringFormatConverter}}" Foreground="{StaticResource StatusPtBrush}" FontWeight="Bold" />
                                        <TextBlock Text="buổi" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Time Range -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Giờ bắt đầu:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TimePicker Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Giờ kết thúc:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TimePicker Time="{x:Bind ViewModel.EndTime, Mode=TwoWay}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <!-- Collision Guardrail Alert -->
                    <Border Visibility="{x:Bind ViewModel.HasCollision, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#3D1212" BorderBrush="{StaticResource StatusDangerBrush}" BorderThickness="1.5"
                            CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="{StaticResource StatusDangerBrush}" />
                                <TextBlock Text="CẢNH BÁO TRÙNG LỊCH PT" FontWeight="Bold" FontSize="12" Foreground="{StaticResource StatusDangerBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CollisionWarning, Mode=OneWay}"
                                       Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Status / Feedback -->
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <!-- Book Slot Action -->
                    <Button Content="Xếp Lịch Tập PT (F5)"
                            Command="{x:Bind ViewModel.BookSlotCommand}"
                            IsEnabled="{x:Bind ViewModel.CanBookSlot, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            Background="{StaticResource StatusPtBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            FontSize="14"
                            CornerRadius="8" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Column: Scheduled Slots List -->
        <Border Grid.Column="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="LỊCH TRÌNH DẠY THEO TUẦN"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Các ca tập đã xếp của huấn luyện viên trong khung giờ 06:00 - 22:00"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="Tải Lại Lịch"
                            Command="{x:Bind ViewModel.LoadScheduleCommand}"
                            HorizontalAlignment="Right" Height="36" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ScheduledSlots}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:PtSessionSlotDto">
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Time Slot -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ScheduledDate, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind StartTime, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" />
                                            <TextBlock Text="-" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind EndTime, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Member & PT -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind MemberName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind PtName}" FontSize="13" Foreground="{StaticResource StatusPtBrush}" />
                                    </StackPanel>

                                    <!-- Status Tag -->
                                    <Border Grid.Column="2" VerticalAlignment="Center"
                                            Background="#1E293B" BorderBrush="{StaticResource StatusPtBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{x:Bind SessionStatus}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatusPtBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
