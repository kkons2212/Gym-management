<Page
    x:Class="GymManagement.Desktop.Views.CheckInCounterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="QUẦY ĐIỂM DANH &amp; CỔNG TỰ ĐỘNG"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Canvas sạch sẵn sàng tái cấu trúc giao diện theo ui_rules.md &amp; ux_rules.md (UC03)"
                       FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Blank Workspace -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="[Vùng thiết kế 2 cột: Webcam QR &amp; Kết quả điểm danh Backend]"
                           Foreground="{StaticResource TextFillColorTertiaryBrush}"
                           FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</Page>
