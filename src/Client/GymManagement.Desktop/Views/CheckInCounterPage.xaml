<Page
    x:Class="GymManagement.Desktop.Views.CheckInCounterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    xmlns:dto="using:GymManagement.Server.Core.DTOs.CheckIn"
    Background="{StaticResource BgCanvasBrush}">

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Webcam Scanner & Manual Lookup & Actions -->
        <Grid Grid.Column="0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Camera Viewport Card -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <!-- Simulated Camera Viewfinder -->
                    <Border Background="#090D16" CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE722;" FontSize="48" Foreground="{StaticResource AccentPrimaryBrush}" />
                            <TextBlock Text="WEBCAM QUÉT MÃ QR HỘI VIÊN"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Đưa màn hình điện thoại có mã QR vào trước camera"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                            <Border BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="2"
                                    Width="160" Height="160" CornerRadius="8" Margin="0,8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Fallback Manual Lookup (Member Code or Phone) & Quick Actions -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tra Cứu &amp; Điểm Danh Thủ Công (Quên / Hết Pin Điện Thoại):"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearchInput"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Nhập mã hội viên hoặc SĐT (USR001 / 0901234567)"
                                 KeyDown="TxtSearchInput_KeyDown"
                                 Height="38" />
                        <Button Grid.Column="1"
                                Content="Điểm Danh"
                                Command="{x:Bind ViewModel.CheckInManualCommand}"
                                Background="{StaticResource AccentPrimaryBrush}"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                Height="38" />
                    </Grid>

                    <!-- Quick Actions: Manual Override Dialog & Gate Diagnostics -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Click="BtnOpenOverrideDialog_Click"
                                HorizontalAlignment="Stretch"
                                Background="#3B2610"
                                BorderBrush="{StaticResource StatusWarningBrush}"
                                BorderThickness="1"
                                Height="38">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource StatusWarningBrush}" />
                                <TextBlock Text="Cho vào thủ công" FontWeight="SemiBold" Foreground="{StaticResource StatusWarningBrush}" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.TestGateCommand}"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Height="38">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" />
                                <TextBlock Text="Mở cổng kiểm tra" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Gate Status Feedback -->
                    <Border Visibility="{x:Bind ViewModel.HasGateMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,6">
                        <TextBlock Text="{x:Bind ViewModel.GateStatusMessage, Mode=OneWay}"
                                   Foreground="#34D399" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right Column: Verification Result Display (Top) & Real-time Attendance Monitoring (Bottom) -->
        <Grid Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Row: Standby Card or Verification Result Card -->
            <Grid Grid.Row="0" MinHeight="220">
                <!-- Idle / Standby Card -->
                <Border Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="28">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE8B9;" FontSize="48" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="SẴN SÀNG TIẾP NHẬN HỘI VIÊN"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Hội viên quét mã QR trên cổng hoặc đọc SĐT để xác minh"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Result Card -->
                <Border Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                        BorderThickness="2"
                        CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Banner (Green or Red Static Banner) -->
                        <Border Grid.Row="0"
                                Background="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                                CornerRadius="14,14,0,0"
                                Padding="16,12">
                            <TextBlock Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <!-- Member Core Details: Mã hội viên (UserName) & Họ tên (FullName) -->
                        <StackPanel Grid.Row="1" Padding="20" Spacing="14" VerticalAlignment="Center">
                            <!-- Two Core Fields: UserName and FullName (No photo) -->
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.MemberCode, Mode=OneWay}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MemberName, Mode=OneWay}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.PlanName, Mode=OneWay}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Error Message if Failed -->
                            <Border Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                    Background="#3A1515" BorderBrush="{StaticResource StatusDangerBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                           Foreground="#FCA5A5" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </Border>

                            <!-- Session Chips Grid (Success) -->
                            <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Gym Session Card -->
                                <Border Grid.Column="0"
                                        Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="LƯỢT TẬP GYM CÒN LẠI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.RemainingGymSessions, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- PT Session Card -->
                                <Border Grid.Column="1"
                                        Background="#0F172A" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="BUỔI TẬP PT CÒN LẠI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.RemainingPtSessions, Mode=OneWay, Converter={StaticResource StringFormatConverter}}"
                                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource StatusPtBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Row: Real-time Attendance Monitoring (UC 3.3) -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Title, Live Attendance Badge, Shift Filter & Refresh -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Section Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="{StaticResource AccentPrimaryBrush}" />
                            <TextBlock Text="NHẬT KÝ ĐIỂM DANH HÔM NAY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Live Attendance Badge -->
                        <Border Grid.Column="1" HorizontalAlignment="Left"
                                Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                CornerRadius="12" Padding="10,4" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#34D399" />
                                <TextBlock Text="Hiện diện trong phòng: " FontSize="12" Foreground="#D1FAE5" />
                                <TextBlock Text="{x:Bind ViewModel.AttendanceCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#34D399" />
                                <TextBlock Text=" người" FontSize="12" Foreground="#D1FAE5" />
                            </StackPanel>
                        </Border>

                        <!-- Shift Filter -->
                        <ComboBox Grid.Column="2" SelectedIndex="0"
                                  SelectionChanged="CboShift_SelectionChanged"
                                  Height="32" FontSize="12">
                            <ComboBoxItem Content="Tất cả các ca" Tag="ALL" />
                            <ComboBoxItem Content="Ca Sáng (06:00 - 12:00)" Tag="MORNING" />
                            <ComboBoxItem Content="Ca Chiều (12:00 - 17:00)" Tag="AFTERNOON" />
                            <ComboBoxItem Content="Ca Tối (17:00 - 22:00)" Tag="EVENING" />
                        </ComboBox>

                        <!-- Refresh Button -->
                        <Button Grid.Column="3"
                                Command="{x:Bind ViewModel.RefreshMonitoringCommand}"
                                Height="32" Width="36" Padding="0"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Logs Table -->
                    <Border Grid.Row="1" Background="{StaticResource BgCanvasBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Grid Grid.Row="0" Background="#131B2E" Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GIỜ VÀO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="HỘI VIÊN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="PHƯƠNG THỨC" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="NGƯỜI DUYỆT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="TRẠNG THÁI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Table Rows -->
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TodayLogs, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:CheckInLogDto">
                                        <Grid Padding="12,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Check-in Time -->
                                            <TextBlock Grid.Column="0" Text="{x:Bind CheckInTime, Converter={StaticResource TimeOnlyFormatterConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Member Name -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind MemberName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- CheckIn Method -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind CheckInMethod}" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Admin Name -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind VerifiedByAdminName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Status -->
                                            <Border Grid.Column="4" HorizontalAlignment="Right"
                                                    Background="{x:Bind Status, Converter={StaticResource StatusToBrushConverter}}"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
