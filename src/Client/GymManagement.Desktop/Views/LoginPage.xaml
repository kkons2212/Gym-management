<Page
    x:Class="GymManagement.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="420"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36">
            <StackPanel Spacing="20">
                <!-- Header / Logo -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="GYM MANAGEMENT SYSTEM"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentFillColorDefaultBrush}"
                               CharacterSpacing="100"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Cổng Quản Trị Viên"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Canvas sạch sẵn sàng tái cấu trúc UI theo ui_rules.md &amp; ux_rules.md (UC01)"
                               FontSize="12"
                               Foreground="{StaticResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 1-Click Login Navigation for Development -->
                <Button x:Name="BtnLogin"
                        Content="Đăng Nhập Quản Trị Viên (Vào Hệ Thống)"
                        Click="BtnLogin_Click"
                        HorizontalAlignment="Stretch"
                        Height="44"
                        Background="{StaticResource AccentFillColorDefaultBrush}"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        CornerRadius="8" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
