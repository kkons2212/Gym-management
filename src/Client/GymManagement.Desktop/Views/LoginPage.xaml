<Page
    x:Class="GymManagement.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:GymManagement.Desktop.ViewModels"
    Background="{StaticResource BgCanvasBrush}">

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="420"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36">
            <StackPanel Spacing="20">
                <!-- Header / Logo -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="GYM MANAGEMENT SYSTEM"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               CharacterSpacing="100"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Cổng Quản Trị Viên"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Đăng nhập để điều hành vận hành phòng tập"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Inputs -->
                <StackPanel Spacing="14" Margin="0,10,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tên đăng nhập / Email" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBox x:Name="TxtUsername"
                                 Text="{x:Bind ViewModel.Username, Mode=TwoWay}"
                                 KeyDown="Input_KeyDown"
                                 PlaceholderText="admin@gymsystem.vn"
                                 Height="40" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Mật khẩu" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <PasswordBox x:Name="TxtPassword"
                                     PasswordChanged="TxtPassword_PasswordChanged"
                                     KeyDown="Input_KeyDown"
                                     PlaceholderText="Nhập mật khẩu…"
                                     Height="40" />
                    </StackPanel>

                    <!-- Remember Me Checkbox (ui_rules.md 3.2) -->
                    <CheckBox Content="Ghi nhớ tên đăng nhập"
                              IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}"
                              FontSize="13"
                              Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Error message banner -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                             Severity="Error"
                             Title="Đăng nhập thất bại"
                             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             IsClosable="False" />
                </StackPanel>

                <!-- Login Button with ProgressRing Spinner & Idempotency Lock -->
                <Button Command="{x:Bind ViewModel.LoginCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                        HorizontalAlignment="Stretch"
                        Height="44"
                        Background="{StaticResource AccentPrimaryBrush}"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="14"
                        CornerRadius="8"
                        Margin="0,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="True" Width="18" Height="18" Foreground="#FFFFFF" />
                            <TextBlock Text="Đang xác thực…" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Đăng Nhập Hệ Thống"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                    </Grid>
                </Button>

                <!-- Footer info -->
                <TextBlock Text="Hệ thống nội bộ WinUI 3 Desktop • Quyền Quản trị viên"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
