<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================== -->
    <!-- NEW COLORS PANEL & DESIGN TOKENS (100% DARK MODE - WCAG AA)-->
    <!-- Defined per Document/ui_rules.md & ux_rules.md            -->
    <!-- ======================================================== -->

    <!-- L0: Surfaces & Elevations -->
    <Color x:Key="AppBackgroundColor">#0A0F1D</Color>
    <Color x:Key="LayerFillColorDefault">#111827</Color>
    <Color x:Key="CardBackgroundColor">#1E293B</Color>
    <Color x:Key="ElevatedSurfaceColor">#27354A</Color>
    <Color x:Key="DialogBackgroundColor">#162032</Color>

    <!-- L1: Borders & Dividers -->
    <Color x:Key="SubtleBorderColor">#334155</Color>
    <Color x:Key="ControlStrokeColorDefault">#475569</Color>
    <Color x:Key="FocusVisualPrimaryColor">#38BDF8</Color>
    <Color x:Key="FocusVisualSecondaryColor">#0A0F1D</Color>

    <!-- L2: Typography -->
    <Color x:Key="TextFillColorPrimary">#F8FAFC</Color>
    <Color x:Key="TextFillColorSecondary">#94A3B8</Color>
    <Color x:Key="TextFillColorTertiary">#64748B</Color>
    <Color x:Key="TextFillColorDisabled">#475569</Color>

    <!-- L3: Brand Accent -->
    <Color x:Key="AccentFillColorDefault">#0EA5E9</Color>
    <Color x:Key="AccentFillColorSecondary">#38BDF8</Color>
    <Color x:Key="AccentFillColorTertiary">#0284C7</Color>
    <Color x:Key="AccentSubtleColor">#260EA5E9</Color>

    <!-- L4: Semantic Status -->
    <Color x:Key="StatusSuccessColor">#4ADE80</Color>
    <Color x:Key="StatusWarningColor">#FBBF24</Color>
    <Color x:Key="StatusDangerColor">#F87171</Color>
    <Color x:Key="StatusPtColor">#C084FC</Color>
    <Color x:Key="PtSlotOpenColor">#E2E8F0</Color>

    <!-- L5: Data Visualization -->
    <Color x:Key="BmiUnderweightColor">#60A5FA</Color>
    <Color x:Key="BmiNormalColor">#34D399</Color>
    <Color x:Key="BmiOverweightColor">#FBBF24</Color>
    <Color x:Key="BmiObeseColor">#F87171</Color>
    <Color x:Key="ChartPeakHourColor">#0EA5E9</Color>

    <!-- ======================================================== -->
    <!-- SolidColorBrushes (New Color Tokens)                     -->
    <!-- ======================================================== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LayerFillColorDefault}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="{StaticResource DialogBackgroundColor}" />

    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource SubtleBorderColor}" />
    <SolidColorBrush x:Key="ControlStrokeDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{StaticResource FocusVisualPrimaryColor}" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource FocusVisualSecondaryColor}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource TextFillColorDisabled}" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentFillColorDefault}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentFillColorSecondary}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentFillColorTertiary}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
    <SolidColorBrush x:Key="StatusPtBrush" Color="{StaticResource StatusPtColor}" />
    <SolidColorBrush x:Key="PtSlotOpenBrush" Color="{StaticResource PtSlotOpenColor}" />

    <!-- Legacy / Compatibility Aliases -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource SubtleBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentFillColorDefault}" />

</ResourceDictionary>
