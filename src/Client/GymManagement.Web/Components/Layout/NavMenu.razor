                        <line x1="3" x2="21" y1="10" y2="10" />
                    </svg>
                    <span>Đặt Lịch PT</span>
                </NavLink>
                <NavLink href="/member/inbody" class="desktop-nav-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                    <span>Chỉ Số InBody</span>
                </NavLink>
                <NavLink href="/member/history" class="desktop-nav-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span>Lịch Sử Hoạt Động</span>
                </NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="PT">
        <Authorized>
            <nav class="desktop-nav role-pt-nav" aria-label="Điều hướng chính huấn luyện viên">
                <NavLink href="/pt/schedule" class="desktop-nav-link" Match="NavLinkMatch.All">
