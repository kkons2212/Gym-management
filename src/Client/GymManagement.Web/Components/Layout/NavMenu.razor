@if (IsDesktop)
{
    @* ====================================================================
       DESKTOP TOP NAVIGATION BAR (Viewport >= 768px)
       ==================================================================== *@
    <AuthorizeView Roles="Member">
        <Authorized>
            <nav class="desktop-nav" aria-label="Điều hướng chính hội viên">
                <NavLink href="/member/dashboard" class="desktop-nav-link" Match="NavLinkMatch.All">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <span>Thông Tin Cá Nhân</span>
                </NavLink>
                <NavLink href="/member/packages" class="desktop-nav-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="14" x="2" y="5" rx="2" />
                        <line x1="2" x2="22" y1="10" y2="10" />
                    </svg>
                    <span>Gói Tập &amp; Gia Hạn</span>
                </NavLink>
                <NavLink href="/member/booking" class="desktop-nav-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
