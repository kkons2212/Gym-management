@inject IWebApiClient WebApiClient
@inject NavigationManager Navigation
@implements IDisposable

<div class="notification-bell-wrapper">
    <!-- Nút Quả chuông trên thanh điều hướng Top Bar -->
    <button type="button" 
            class="notification-bell-btn @(isOpen ? "active" : "")" 
            @onclick="ToggleDropdown" 
            title="Thông báo"
            aria-label="Thông báo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>

        @if (unreadCount > 0)
        {
            <span class="notification-badge">
                @if (unreadCount > 99)
                {
                    <span>99+</span>
                }
                else
                {
                    <span>@unreadCount</span>
                }
            </span>
        }
    </button>

    <!-- Dropdown / Popover danh sách thông báo -->
    @if (isOpen)
    {
        <!-- Backdrop bắt sự kiện bấm ra ngoài để đóng menu -->
        <div class="notification-backdrop" @onclick="CloseDropdown"></div>

        <div class="notification-dropdown-menu">
            <!-- Header của Dropdown -->
            <div class="notification-header">
                <div class="notification-header-title">
                    <span>Thông báo</span>
                    @if (unreadCount > 0)
                    {
                        <span class="notification-unread-pill">@unreadCount mới</span>
                    }
                </div>

                <div class="notification-header-actions">
                    @if (unreadCount > 0)
                    {
                        <button type="button" class="btn-mark-all-read" @onclick="MarkAllAsRead">
                            Đánh dấu đã đọc
                        </button>
                    }
                    <button type="button" class="btn-close-dropdown" @onclick="CloseDropdown" title="Đóng">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Danh sách thông báo -->
            <div class="notification-list">
                @if (isLoading)
                {
                    <div class="notification-empty">
                        <div class="spinner-border text-info" role="status" style="width: 1.5rem; height: 1.5rem;"></div>
                        <span style="margin-top: 8px; font-size: 13px;">Đang tải thông báo...</span>
                    </div>
                }
                else if (notifications.Count == 0)
                {
                    <div class="notification-empty">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <p style="margin-top: 10px; font-size: 13px; color: var(--text-secondary);">Bạn chưa có thông báo nào</p>
                    </div>
                }
                else
                {
                    @foreach (var item in notifications)
                    {
                        string itemClass = "notification-item";
                        if (!item.IsRead)
                        {
                            itemClass = "notification-item unread";
                        }

                        <div class="@itemClass" @onclick="() => HandleNotificationClick(item)">
                            <div class="notification-item-icon">
                                @if (!item.IsRead)
                                {
                                    <span class="unread-dot"></span>
                                }
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </div>
                            <div class="notification-item-body">
                                <div class="notification-item-header">
                                    <span class="notification-item-title">@item.Title</span>
                                    <span class="notification-item-date">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                                <p class="notification-item-message">@item.Message</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<style>
    .notification-bell-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .notification-bell-btn {
        position: relative;
        background: transparent;
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .notification-bell-btn:hover,
    .notification-bell-btn.active {
        color: var(--text-primary);
        background: var(--bg-surface-elevated);
        border-color: var(--accent-primary);
    }

    .notification-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: var(--status-danger);
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
        min-width: 18px;
        height: 18px;
        line-height: 18px;
        border-radius: 9px;
        padding: 0 4px;
        text-align: center;
        box-shadow: 0 0 0 2px var(--bg-surface);
    }

    .notification-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 998;
        background: transparent;
    }

    .notification-dropdown-menu {
        position: absolute;
        top: 44px;
        right: 0;
        width: 320px;
        max-width: 90vw;
        max-height: 480px;
        background: var(--bg-surface);
        border: 1px solid var(--border-strong);
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
        z-index: 999;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .notification-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border-subtle);
        background: var(--bg-surface-elevated);
    }

    .notification-header-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 14px;
        color: var(--text-primary);
    }

    .notification-unread-pill {
        background: rgba(14, 165, 233, 0.15);
        color: var(--accent-primary);
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 10px;
        font-weight: 600;
    }

    .notification-header-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-mark-all-read {
        background: transparent;
        border: none;
        color: var(--accent-primary);
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .btn-mark-all-read:hover {
        text-decoration: underline;
    }

    .btn-close-dropdown {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-size: 14px;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .btn-close-dropdown:hover {
        color: var(--text-primary);
    }

    .notification-list {
        overflow-y: auto;
        flex: 1;
        max-height: 400px;
    }

    .notification-empty {
        padding: 32px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .notification-item {
        display: flex;
        gap: 10px;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border-subtle);
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .notification-item:hover {
        background-color: var(--bg-surface-elevated);
    }

    .notification-item.unread {
        background-color: rgba(14, 165, 233, 0.08);
    }

    .notification-item.unread:hover {
        background-color: rgba(14, 165, 233, 0.14);
    }

    .notification-item-icon {
        position: relative;
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--bg-canvas);
        color: var(--accent-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .unread-dot {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--status-danger);
    }

    .notification-item-body {
        flex: 1;
        min-width: 0;
    }

    .notification-item-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 4px;
    }

    .notification-item-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .notification-item-date {
        font-size: 11px;
        color: var(--text-muted);
        flex-shrink: 0;
    }

    .notification-item-message {
        font-size: 12px;
        color: var(--text-secondary);
        line-height: 1.4;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    private bool isOpen = false;
    private bool isLoading = false;
    private int unreadCount = 0;
    private List<NotificationDto> notifications = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadUnreadCount();
    }

    private async Task ToggleDropdown()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            await LoadNotifications();
        }
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private async Task LoadUnreadCount()
    {
        try
        {
            unreadCount = await WebApiClient.GetUnreadNotificationCountAsync();
        }
        catch
        {
            unreadCount = 0;
        }
    }

    private async Task LoadNotifications()
    {
        isLoading = true;
        try
        {
            var result = await WebApiClient.GetNotificationsAsync();
            notifications = result.ToList();
            unreadCount = notifications.Count(n => !n.IsRead);
        }
        catch
        {
            notifications = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleNotificationClick(NotificationDto item)
    {
        if (!item.IsRead)
        {
            try
            {
                await WebApiClient.MarkNotificationAsReadAsync(item.NotificationId);
                int index = notifications.FindIndex(n => n.NotificationId == item.NotificationId);
                if (index >= 0)
                {
                    notifications[index] = item with { IsRead = true };
                }

                if (unreadCount > 0)
                {
                    unreadCount--;
                }
            }
            catch
            {
                // Bỏ qua lỗi kết nối khi thao tác đọc thông báo
            }
        }
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            await WebApiClient.MarkAllNotificationsAsReadAsync();
            for (int i = 0; i < notifications.Count; i++)
            {
                notifications[i] = notifications[i] with { IsRead = true };
            }
            unreadCount = 0;
        }
        catch
        {
            // Bỏ qua lỗi
        }
    }

    public void Dispose()
    {
        // Dọn dẹp tài nguyên
    }
}
