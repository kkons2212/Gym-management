@page "/member/inbody"
@attribute [Authorize(Roles = "Member")]

<div style="display: flex; flex-direction: column; gap: 16px;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1 style="font-size: 18px; font-weight: 700; margin: 0; color: #F8FAFC;">
                Chỉ Số Thể Hình InBody
            </h1>
            <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                Theo dõi cân nặng, khối lượng cơ, tỷ lệ mỡ và BMI
            </div>
        </div>
        <button type="button"
                @onclick="ReloadAsync"
                class="btn-secondary"
                style="padding: 6px 10px; font-size: 12px; min-height: 32px;"
                title="Làm mới">
            ↻
        </button>
    </div>

    <!-- InBody Dashboard Component -->
    <InBodyDashboard @ref="_dashboard" />
</div>

@code {
    private InBodyDashboard? _dashboard;

    private async Task ReloadAsync()
    {
        if (_dashboard != null)
        {
            await _dashboard.ReloadAsync();
        }
    }
}
